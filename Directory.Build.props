<Project>

  <!--
    Zajedničke postavke prevođenja za sve projekte u ovom rešenju.

    Upozorenja se tretiraju kao greške SAMO u Release konfiguraciji - to je ona koju
    gradi CI (release.yml), pa nijedno upozorenje ne može da prođe u objavljenu verziju.
    U Debug-u ostaju obična upozorenja da rad na kodu ne bi bio prekidan pri svakoj
    nedovršenoj izmeni.

    NU1701 je izuzet: LiveCharts/SkiaSharp povlače pakete građene za .NET Framework,
    što ne možemo popraviti iz ovog koda.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <!--
      CI objavljuje single-file build (dotnet publish -p:PublishSingleFile=true), a taj
      režim prijavljuje greške poput IL3000 (Assembly.Location nema smisla u single-file
      paketu) koje obično prevođenje ne vidi. Bez ovoga upozorenja iskaču tek u koraku
      objavljivanja — dakle POSLE nego što testovi prođu — pa kapija kvaliteta propusti
      grešku koja onda obori release. Sa uključenim analizatorom iste greške iskaču već
      pri "dotnet build", pa ih test job uhvati na vreme.
    -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

</Project>

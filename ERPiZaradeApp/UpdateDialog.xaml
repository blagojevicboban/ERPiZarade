<Window x:Class="ERPiZaradeApp.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ažuriranje aplikacije"
        Height="250" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Padding="20" Background="{StaticResource CardBrush}" Margin="10" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="4" Opacity="0.1"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Dostupna je nova verzija!" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Text="Da li želite da preuzmete i instalirate novu verziju aplikacije sada?"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       VerticalAlignment="Top"/>

            <!-- Progress elements (Hidden by default) -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,15,0,0">
                <TextBlock x:Name="ProgressText" Text="Preuzimanje: 0%" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ProgressBar x:Name="UpdateProgress" Height="10" Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" Background="{StaticResource BorderBrush}"/>
            </StackPanel>

            <!-- Buttons (Hidden during update) -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Kasnije" 
                        Style="{StaticResource SecondaryButton}" 
                        Width="100" Margin="0,0,10,0" 
                        Click="BtnCancel_Click"/>
                
                <Button Content="Ažuriraj sada" 
                        Style="{StaticResource PrimaryButton}" 
                        Width="120" 
                        Click="BtnUpdate_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

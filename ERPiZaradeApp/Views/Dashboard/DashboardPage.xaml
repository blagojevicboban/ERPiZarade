<Page x:Class="ERPiZaradeApp.Views.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:local="clr-namespace:ERPiZaradeApp.Views.Dashboard"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Radna tabla"
      Background="{StaticResource SurfaceBrush}">

    <Page.DataContext>
        <local:DashboardViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Naslov -->
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource PageSubtitle}">
                    <Run Text="Pregled i statistika obračuna zarada — aktivni period:"/>
                    <Run Text="{Binding AktivniPeriodText}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <!-- KPI Kartice -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Aktivnih radnika" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UkupnoAktivnihRadnika}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ukupna neto masa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UkupnaNetoMasa, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ukupna bruto masa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UkupnaBrutoMasa, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Aktivnih kredita" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BrojAktivnihKredita}" FontSize="30" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pregled po mesecima -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="320"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                            <Run Text="Pregled zarada po mesecima za"/>
                            <Run Text="{Binding SelectedGodina, Mode=OneWay}"/>
                            <Run Text="godinu"/>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Godina:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding Godine}" SelectedItem="{Binding SelectedGodina}" Padding="8,5" MinWidth="90"/>
                        </StackPanel>
                    </Grid>

                    <lvc:CartesianChart Grid.Row="1" Series="{Binding MesecniSeries}" XAxes="{Binding MesecniXAxes}" YAxes="{Binding MesecniYAxes}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="ERPiZaradeApp.Views.Firme.FirmePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Firme"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Content: lista + forma -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>


        <!-- ── TOOLBAR ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pretraga -->
                <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 x:Name="SearchBox" Padding="4,7" FontSize="13"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Pretraži firme po nazivu ili PIB-u..." Foreground="#9CA3AF"
                                   FontSize="13" Margin="6,8,0,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Dugmad -->
                <Button Grid.Column="1" Content="➕  Nova firma"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnNovaFirma_Click"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="✏️  Izmeni"
                        Style="{StaticResource SecondaryButton}"
                        x:Name="BtnIzmeni"
                        Click="BtnIzmeni_Click"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="🗑️  Obriši"
                        Style="{StaticResource SecondaryButton}"
                        x:Name="BtnObrisi"
                        Click="BtnObrisi_Click"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="⭐ Postavi kao aktivnu"
                        Style="{StaticResource PrimaryButton}"
                        Background="#10B981"
                        x:Name="BtnAktivna"
                        Click="BtnAktivna_Click"/>
            </Grid>
        </Border>

        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Lista firmi -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
                <DataGrid x:Name="FirmeGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          Margin="0"
                          SelectionChanged="FirmeGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naziv firme" Binding="{Binding Naziv}" Width="*"/>
                        <DataGridTextColumn Header="PIB" Binding="{Binding Pib}" Width="110"/>
                        <DataGridTextColumn Header="Matični broj" Binding="{Binding Mb}" Width="110"/>
                        <DataGridTextColumn Header="Grad" Binding="{Binding Grad}" Width="120"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="120"/>
                        <DataGridTextColumn Header="Fajl baze" Binding="{Binding DbPath}" Width="250"/>
                        <DataGridTemplateColumn Header="Aktivna" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBorder" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Background="Transparent">
                                        <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold" Text="" Foreground="#065F46"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentlyActive}" Value="True">
                                            <Setter TargetName="StatusBorder" Property="Background" Value="#D1FAE5"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="AKTIVNA"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Forma za prikaz/uređivanje -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- Form Content -->
                    <ScrollViewer x:Name="FormScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="20">
                            <!-- Header forme -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="FormHeaderTitle" Text="Detalji firme" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Rectangle Height="2" Margin="0,8,0,0">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3949AB" Offset="0"/>
                                            <GradientStop Color="#00BCD4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </StackPanel>

                            <!-- Forma polja -->
                            <StackPanel x:Name="FormFieldsPanel" IsEnabled="False">
                                <!-- Naziv firme -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Naziv firme *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNaziv" Height="32"/>
                                </StackPanel>

                                <!-- Fajl baze -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Fajl baze (samo za pregled)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtDbPath" Height="32" IsReadOnly="True" Background="#F3F4F6"/>
                                </StackPanel>

                                <!-- PIB i MB -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="PIB *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPib" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Matični broj (MB)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtMb" Height="32"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Adresa, Grad i šifra opštine sedišta -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Adresa" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtAdresa" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Grad" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtGrad" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Šifra opštine" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtSifraOpstine" Height="32" MaxLength="3"
                                                 ToolTip="Šifra opštine sedišta po šifarniku Poreske uprave — ide u zaglavlje PPP-PD prijave"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bankovni račun i Šifra plaćanja -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Bankovni račun" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtBankovniRacun" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Šifra plaćanja" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtSifraPlacanja" Height="32"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Telefon i Email -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Telefon" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtTelefon" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Email" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtEmail" Height="32"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Zastupnik: ugovor van radnog odnosa se zaključuje „koga zastupa…" -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Zastupnik" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtZastupnik" Height="32"
                                                 ToolTip="Ime i prezime lica koje firmu zastupa pri potpisivanju ugovora"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Funkcija zastupnika" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtFunkcijaZastupnika" Height="32"
                                                 ToolTip="npr. direktor, zakonski zastupnik"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Napomena -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Napomena" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNapomena" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,6"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Save / Cancel Buttons panel -->
                            <StackPanel x:Name="ActionButtonsPanel" Visibility="Collapsed">
                                <Button Content="💾  Sačuvaj"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="BtnSacuvaj_Click"
                                        Margin="0,0,0,8"/>
                                <Button Content="✖  Otkaži"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnOtkazi_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Placeholder when no selection -->
                    <TextBlock x:Name="NoSelectionPlaceholder" Text="← Izaberite firmu iz liste ili kliknite na 'Nova firma'"
                               FontSize="13" Foreground="#9CA3AF"
                               HorizontalAlignment="Center" Margin="0,40,0,0" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="TxtStatus" Text="Spreman" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

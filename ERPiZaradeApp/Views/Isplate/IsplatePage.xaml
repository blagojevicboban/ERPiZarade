<Page x:Class="ERPiZaradeApp.Views.Isplate.IsplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Isplate u mesecu"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── PERIOD ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Godina" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ComboGodina" Width="90" Height="30" VerticalContentAlignment="Center"
                              SelectionChanged="ComboPeriod_SelectionChanged" Margin="0,0,16,0"/>

                    <TextBlock Text="Mesec" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ComboMesec" Width="70" Height="30" VerticalContentAlignment="Center"
                              SelectionChanged="ComboPeriod_SelectionChanged"/>
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Margin="24,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Mesec sa jednom isplatom radi kao i do sada. Druga isplata se dodaje kad se zarada isplaćuje u više navrata — akontacija pa konačna, bonus, 13. plata. Svaka isplata ima svoju PPP-PD prijavu, svoj BOP i svoj paket naloga."/>

                <Button Grid.Column="2" Content="💾  Sačuvaj" Style="{StaticResource PrimaryButton}" Padding="16,6"
                        Click="BtnSacuvaj_Click"/>
            </Grid>
        </Border>

        <!-- ── DODAVANJE ──────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Nova isplata:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>

                <TextBlock Text="Vrsta" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                <ComboBox x:Name="ComboVrsta" Width="150" Height="30" VerticalContentAlignment="Center"
                          DisplayMemberPath="Naziv" Margin="0,0,16,0"
                          ToolTip="Vrsta određuje dve stvari: oznaku za konačnu isplatu na PPP-PD prijavi i to da li se na isplati skidaju obustave."/>

                <TextBlock Text="Opis" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtOpis" Width="240" Height="30" VerticalContentAlignment="Center"
                         Padding="8,0" Margin="0,0,16,0" MaxLength="80"/>

                <TextBlock Text="Datum isplate" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                <DatePicker x:Name="DatumNove" Width="130" Height="30" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <Button Content="➕" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                        Click="BtnDodaj_Click" ToolTip="Dodaj isplatu u izabrani mesec"/>
                <Button Content="🗑" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                        Click="BtnObrisi_Click"
                        ToolTip="Obriši izabranu isplatu — moguće samo za poslednju u mesecu, i samo dok nema obračuna ni prijave"/>
                <Button Content="🔗" Style="{StaticResource SecondaryButton}" Width="36" Padding="0"
                        Click="BtnPovezi_Click"
                        ToolTip="Veže obračune bez isplate za prvu isplatu meseca. Ne menja nijedan iznos — samo upisuje ono što se do sada podrazumevalo."/>
            </StackPanel>
        </Border>

        <!-- ── SADRŽAJ ────────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0">
                <DataGrid x:Name="GridIsplate" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Br." Binding="{Binding RedniBroj}" Width="45" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Vrsta" Binding="{Binding VrstaNaziv}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Opis" Binding="{Binding Opis, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTemplateColumn Header="Datum isplate" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding DatumIsplate, UpdateSourceTrigger=PropertyChanged}"
                                                BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Obračuna" Binding="{Binding BrojObracuna}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Neto" Binding="{Binding Neto, StringFormat=N2}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Kon." Binding="{Binding OznakaKonacne}" Width="45" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Obustave" Binding="{Binding ObustaveStr}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="BOP" Binding="{Binding Bop}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Prijava" Binding="{Binding StatusPrijaveStr}" Width="110" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="KONTROLNE PROVERE" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Provere se pokreću tek kad mesec ima više od jedne isplate — dotle nema šta da se razmimoiđe."/>

                    <DataGrid x:Name="GridNalazi" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding TezinaTekst}" Width="80"/>
                            <DataGridTextColumn Header="Nalaz" Binding="{Binding Opis}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── STATUS ─────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

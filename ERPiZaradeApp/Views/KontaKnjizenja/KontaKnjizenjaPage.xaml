<Page x:Class="ERPiZaradeApp.Views.KontaKnjizenja.KontaKnjizenjaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Konta za knjiženje"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Protivstava troška zarade ne zavisi od toga šta je isplaćeno nego od uloge iznosa u nalogu — neto obaveza, porez, doprinosi, obustava. Zato svaka uloga ovde ima svoj red. Brojevi su početna vrednost iz Kontnog okvira; firma koja vodi analitiku ih menja, i to bez nove verzije. Konto troška ostaje uz vrstu primanja i vrstu ugovora."/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="↩" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                            Click="BtnVratiPodrazumevano_Click"
                            ToolTip="Vrati podrazumevane brojeve konta iz Kontnog okvira"/>
                    <Button Content="💾  Sačuvaj" Style="{StaticResource PrimaryButton}" Padding="16,6"
                            Click="BtnSacuvaj_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="GridKonta" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12"
                      SelectionChanged="GridKonta_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Strana" Binding="{Binding StranaTekst}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Konto" Binding="{Binding Konto, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="Ključ" Binding="{Binding Kljuc}" Width="240" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="ToolTip" Value="Ime po kome program traži ovaj konto; ne menja se"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="NapomenaKonta" Text="" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

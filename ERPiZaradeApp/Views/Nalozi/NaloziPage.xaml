<Page x:Class="ERPiZaradeApp.Views.Nalozi.NaloziPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ERPiZaradeApp.Views.Nalozi"
      Title="Nalozi za prenos"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <!-- DataContext se postavlja u konstruktoru, jer ViewModel prima rod isplate:
         ista stranica služi i zaradama i naknadama van radnog odnosa. -->

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEVO: prijava, datum valute, zbirovi ───────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Isplata (Faza 2.2): vidljivo tek kad mesec ima više od jedne. -->
                        <StackPanel Margin="0,0,0,14"
                                    Visibility="{Binding ImaViseIsplata, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ISPLATA" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Paket se pravi za jednu isplatu. Prijava i BOP se uzimaju iz prijave upravo te isplate."/>
                            <ComboBox ItemsSource="{Binding Isplate}" DisplayMemberPath="Naziv"
                                      SelectedItem="{Binding IzabranaIsplata, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="OBJEDINJENA NAPLATA" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Porezi i doprinosi se plaćaju jednom uplatom, sa BOP-om iz prihvaćene PPP-PD prijave kao pozivom na broj."/>

                        <Button Content="📥  Učitaj dokument sa ePorezi"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding UcitajEPoreziCommand}"
                                ToolTip="XML koji ePorezi izda pošto Poreska uprava prihvati PPP-PD prijavu — iz njega se čitaju BOP i iznos"
                                Margin="0,0,0,14"/>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Status prijave" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding StatusPrijaveTekst}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Text="BOP (poziv na broj)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Bop}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Iznos za uplatu" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding IznosZaUplatu, StringFormat=N2}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Text="Uplatni račun / model" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RacunZaUplatu}" FontSize="12"/>
                                    <TextBlock Text="  ·  model " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ModelPozivaNaBroj}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Datum valute" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DatumValute, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="ZBIROVI" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Neto zarade" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ZbirZarada, StringFormat=N2}" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Porezi i doprinosi" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ZbirPorezaIDoprinosa, StringFormat=N2}" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        <Grid>
                            <TextBlock Text="Ukupno" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Ukupno, StringFormat=N2}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Button Content="🔄  Osveži naloge"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding PripremiCommand}"
                                Margin="0,16,0,0"/>

                        <TextBlock Text="IZVOZ ZA BANKU" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryLightBrush}" Margin="0,20,0,8"/>

                        <Button Content="🏛  Hal E-Bank (TXT)"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding IzvoziHalcomCommand}"
                                ToolTip="Format fiksnih pozicija koji prihvata većina poslovnih banaka"
                                Margin="0,0,0,8"/>

                        <Button Content="🏛  Trezorski ePP (JSON)"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding IzvoziTrezorCommand}"
                                ToolTip="Za korisnike sa računom kod Uprave za trezor"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── DESNO: nalozi i nalazi kontrola ────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <DataGrid ItemsSource="{Binding Nalozi}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Primalac" Binding="{Binding PrimalacNaziv}" Width="*"/>
                            <DataGridTextColumn Header="Račun primaoca" Binding="{Binding PrimalacRacun}" Width="150"/>
                            <DataGridTextColumn Header="Šifra pl." Binding="{Binding SifraPlacanja}" Width="70"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding ModelPozivaNaBroj}" Width="55"/>
                            <DataGridTextColumn Header="Poziv na broj" Binding="{Binding PozivNaBroj}" Width="150"/>
                            <DataGridTextColumn Header="Iznos" Binding="{Binding Iznos, StringFormat=N2}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Nalazi kontrola: sakriveni kad ih nema, da ne zauzimaju prostor bez potrebe -->
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" MaxHeight="200">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Nalazi.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="KONTROLE" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Nalazi}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" FontSize="12">
                                            <Run Text="["/><Run Text="{Binding TezinaTekst, Mode=OneWay}"/><Run Text="] "/>
                                            <Run Text="{Binding Radnik, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Provera, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=": "/>
                                            <Run Text="{Binding Opis, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ── STATUS ─────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusTekst}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

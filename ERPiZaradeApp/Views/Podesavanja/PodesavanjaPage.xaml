<Page x:Class="ERPiZaradeApp.Views.Podesavanja.PodesavanjaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ERPiZaradeApp.Views.Podesavanja"
      Title="Podešavanja"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <local:TipBackupBackgroundConverter x:Key="TipBackupBackgroundConverter"/>
        <local:TipBackupForegroundConverter x:Key="TipBackupForegroundConverter"/>

        <!-- Modern TabControl / TabItem styles -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Tab Control Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>


        <!-- ── TAB CONTROL CONTENT ─────────────────────────────────── -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            


            <!-- TAB 2: Rezervna kopija -->
            <TabItem Header="💾 Rezervna kopija">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEVO: Ručne akcije -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                        <StackPanel>
                            <!-- KARTICA 1: Kreiranje rezervne kopije -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="💾 Kreiranje rezervne kopije (Backup)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Sačuvajte trenutno stanje baze podataka na sigurnu lokaciju." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                    <TextBlock Text="Trenutna lokacija aktivne baze podataka:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtAktivnaBazaPath" IsReadOnly="True" Background="#F3F4F6" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                                    <TextBlock Text="Preporučeno ime za rezervnu kopiju:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPredlozenoIme" IsReadOnly="True" Background="#F3F4F6" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,24"/>

                                    <Button x:Name="BtnKreirajBackup" Content="💾 Napravi rezervnu kopiju baze podataka" Style="{StaticResource PrimaryButton}" Height="40" Click="BtnKreirajBackup_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- KARTICA 2: Vraćanje iz rezervne kopije -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="🔄 Vraćanje baze iz datoteke (Restore)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Učitajte prethodno sačuvanu bazu podataka iz izabranog fajla." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                    <Border Background="#FFF3CD" CornerRadius="8" Padding="12" Margin="0,0,0,20" BorderBrush="#FFEBA0" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="⚠️ VAŽNO UPOZORENJE" FontWeight="Bold" Foreground="#856404" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock Text="Vraćanje podataka iz rezervne kopije će u potpunosti zameniti sve trenutne podatke u sistemu za aktivnu firmu! Pre prepisivanja, biće automatski napravljena sigurnosna kopija trenutnog stanja baze." TextWrapping="Wrap" Foreground="#856404" FontSize="12"/>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="BtnVratiBackup" Content="📁 Izaberi i vrati bazu podataka iz kopije" Style="{StaticResource SecondaryButton}" BorderBrush="#DC3545" Foreground="#DC3545" Height="40" Click="BtnVratiBackup_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- DESNO: Istorija automatskih i sigurnosnih kopija -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Naslov -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="⏳ Istorija sigurnosnih i auto-kopija" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Lista kopija kreiranih pri pokretanju ili pre operacije vraćanja. Selektujte jednu da biste je brzo vratili." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                            </StackPanel>

                            <!-- Lista (ListView) -->
                            <ListView x:Name="LstIstorijaKopija" Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" Margin="0,0,0,16" SelectionMode="Single" SelectionChanged="LstIstorijaKopija_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Tip kopije" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,2" CornerRadius="4" 
                                                            Background="{Binding Tip, Converter={StaticResource TipBackupBackgroundConverter}}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Tip}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding Tip, Converter={StaticResource TipBackupForegroundConverter}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Datum kreiranja" DisplayMemberBinding="{Binding DatumPrikaz}" Width="130"/>
                                        <GridViewColumn Header="Veličina" DisplayMemberBinding="{Binding VelicinaPrikaz}" Width="80"/>
                                        <GridViewColumn Header="Naziv fajla" DisplayMemberBinding="{Binding NazivFajla}" Width="250"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- Akcije pod listom -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnVratiIzIstorije" Grid.Column="0" Content="🔄 Vrati bazu iz izabrane kopije" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,0,8,0" Click="BtnVratiIzIstorije_Click" IsEnabled="False"/>
                                <Button x:Name="BtnOtvoriFolderKopija" Grid.Column="1" Content="📂 Otvori folder sa kopijama" Style="{StaticResource SecondaryButton}" Height="40" Click="BtnOtvoriFolderKopija_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: Postavke programa -->
            <TabItem Header="🖥️ Postavke programa">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🖥️ Postavke programa" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Opšte postavke vezane za izgled i ponašanje programa." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                            <!-- Pokretanje maksimizovano -->
                            <Border Background="#F8FAFF" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Pokretanje programa maksimizovano" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Program će se automatski otvoriti u celom ekranu pri sledećem pokretanju." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkPokretanjeMaximizovano" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                              Checked="ChkPostavke_Changed" Unchecked="ChkPostavke_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Stroga validacija JMBG-a -->
                            <Border Background="#F8FAFF" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Stroga validacija JMBG-a" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Omogući detaljnu proveru datuma rođenja i kontrolne cifre JMBG-a (modul 11) pri unosu radnika i izradi poreskih prijava." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkValidacijaJmbgOmogucena" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                              Checked="ChkPostavke_Changed" Unchecked="ChkPostavke_Changed"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Promene se primenjuju pri sledećem pokretanju programa." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: E-mail (slanje platnih listića) -->
            <TabItem Header="✉️ E-mail">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="✉️ Slanje platnih listića e-mailom" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Nalog odlaznog servera preko kog se šalju platni listići. Podaci važe za ovaj računar." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="SMTP server" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSmtpServer" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Port" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSmtpPort" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkSmtpSsl" Grid.Column="2" Content="TLS/SSL" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Korisničko ime" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSmtpKorisnik" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Lozinka" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="TxtSmtpLozinka" Height="32" VerticalContentAlignment="Center"
                                                 ToolTip="Čuva se šifrovano i vezano za Windows nalog na ovom računaru"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Adresa pošiljaoca" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSmtpAdresa" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ime pošiljaoca" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSmtpIme" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F8FAFF" CornerRadius="8" Padding="16,12" Margin="0,4,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Zaštiti platni listić lozinkom" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="PDF se zaključava lozinkom za otvaranje — lozinka je JMBG radnika i ne navodi se u poruci. Radnik bez JMBG-a se preskače umesto da mu se pošalje nezaštićen listić." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkZastitaLozinkom" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Background="#FFF8E1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="#FFE082" BorderThickness="1">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#856404"
                                           Text="Slanjem listića iznose se lični podaci (JMBG, zarada) iz programa. Svako slanje se beleži — kome, kada i na koju adresu — što je obaveza po Zakonu o zaštiti podataka o ličnosti."/>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSacuvajSmtp" Content="💾  Sačuvaj" Style="{StaticResource PrimaryButton}"
                                        Click="BtnSacuvajSmtp_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnProveriSmtp" Content="🔌  Proveri vezu" Style="{StaticResource SecondaryButton}"
                                        Click="BtnProveriSmtp_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

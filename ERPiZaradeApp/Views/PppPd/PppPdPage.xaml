<Page x:Class="ERPiZaradeApp.Views.PppPd.PppPdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ERPiZaradeApp.Views.PppPd"
      Title="PPP-PD poreska deklaracija"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Page.DataContext>
        <local:PppPdViewModel/>
    </Page.DataContext>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>


        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>  <!-- Left Panel: Parameters -->
                <ColumnDefinition Width="*"/>    <!-- Right Panel: Data table & validation -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Parameters Form -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Section: Selection and Parameters -->
                        <TextBlock Text="PARAMETRI PRIJAVE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,12"/>

                        <!-- Isplata (Faza 2.2): vidljivo tek kad mesec ima više od jedne isplate. -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding ImaViseIsplata, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Isplata:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding Isplate}" DisplayMemberPath="Naziv"
                                      SelectedItem="{Binding IzabranaIsplata, Mode=TwoWay}" Padding="8,5"
                                      ToolTip="Prijava se podnosi za jednu isplatu. Akontacija i konačna isplata istog meseca su dve prijave, svaka sa svojim datumom plaćanja i svojim BOP-om."/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Godina:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding Godine}" SelectedItem="{Binding SelectedGodina}" IsEnabled="False" Padding="8,5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Mesec:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding Meseci}" SelectedItem="{Binding SelectedMesec}" IsEnabled="False" Padding="8,5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Datum plaćanja:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <DatePicker SelectedDate="{Binding DatumPlacanja, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Broj kal. dana:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Broj kalendarskih dana u obračunskom periodu — automatski se popunjava prema izabranom mesecu"/>
                                <TextBox Text="{Binding BrojKalendarskihDana, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Klijentska oznaka:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding KlijentskaOznaka, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Vrsta prijave:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox SelectedValue="{Binding SelectedVrstaPrijave}" SelectedValuePath="Tag" Margin="0,0,0,10" Padding="8,5"
                                  ToolTip="Pozicija 1.1 Obrasca PPP-PD. Šifre su propisane specifikacijom Poreske uprave — ne meša se sa vrstom izmene (1.5).">
                            <ComboBoxItem Content="1 - Opšta prijava" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="2 - Po službenoj dužnosti" Tag="2"/>
                            <ComboBoxItem Content="3 - Samoprijavljivanje" Tag="3"/>
                            <ComboBoxItem Content="4 - Po nalazu kontrole" Tag="4"/>
                            <ComboBoxItem Content="5 - Po odluci suda" Tag="5"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Oznaka konačne:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox SelectedValue="{Binding SelectedOznakaZaKonacnu}" SelectedValuePath="Tag" Padding="8,5">
                                    <ComboBoxItem Content="K - Konačna" Tag="K" IsSelected="True"/>
                                    <ComboBoxItem Content="A - Akontacija" Tag="A"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Najniža osnovica:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox SelectedValue="{Binding SelectedNajnizaOsnovica}" SelectedValuePath="Tag" Padding="8,5">
                                    <ComboBoxItem Content="0 - Bez primene" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="1 - Sa primenom" Tag="1"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Tip isplatioca:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox SelectedValue="{Binding SelectedTipIsplatioca}" SelectedValuePath="Tag" Margin="0,0,0,16" Padding="8,5"
                                  ToolTip="Pozicija 2.1 Obrasca PPP-PD, po specifikaciji Poreske uprave.">
                            <ComboBoxItem Content="1 - Pravno lice, nije iz budžeta" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="2 - Pravno lice iz budžeta" Tag="2"/>
                            <ComboBoxItem Content="3 - Strano predstavništvo" Tag="3"/>
                            <ComboBoxItem Content="4 - Preduzetnik" Tag="4"/>
                            <ComboBoxItem Content="5 - Fizičko lice" Tag="5"/>
                            <ComboBoxItem Content="6 - Vojska RS" Tag="6"/>
                            <ComboBoxItem Content="7 - Poljoprivredno gazdinstvo" Tag="7"/>
                        </ComboBox>

                        <Separator Margin="0,4,0,12"/>

                        <TextBlock Text="IZMENJENA PRIJAVA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Popunjava se samo kada se menja ranije podneta prijava. Sva polja tada idu zajedno — bez JIPD-a Poreska uprava ne zna koja se prijava menja."
                                   FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Vrsta izmene (1.5):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding VrsteIzmene}" SelectedItem="{Binding VrstaIzmene}" Margin="0,0,0,10" Padding="8,5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static local:VrstaIzmeneConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Visibility="{Binding JeIzmenjenaPrijava, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="JIPD prijave koja se menja (1.5a):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding JipdKojiSeMenja, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="8,5"
                                     ToolTip="Do 19 cifara. Dodeljuje ga Poreska uprava pri prijemu prvobitne prijave — nije isto što i BOP."/>

                            <TextBlock Text="Broj rešenja (1.6):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding BrojResenja, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="8,5"
                                     ToolTip="Broj rešenja kontrole ili suda; ostaje prazno kada izmenu podnosi sam poslodavac."/>

                            <TextBlock Text="Osnov podnošenja (1.6a):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding OsnoviIzmene}" SelectedItem="{Binding OsnovIzmene}" Margin="0,0,0,16" Padding="8,5">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static local:OsnovIzmeneConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Separator Margin="0,4,0,12"/>

                        <!-- Section: Employer Info -->
                        <TextBlock Text="PODACI O ISPLATIOCU" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Naziv isplatioca:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Naziv, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="PIB:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding Pib, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Matični broj:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding MaticniBroj, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Sedište (Opština):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding Sediste, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Telefon:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Adresa isplatioca:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Adresa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="E-mail:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <Button Content="💾  Sačuvaj podatke o isplatiocu" Style="{StaticResource SecondaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch"
                                ToolTip="Pamti PIB, adresu, kontakt i podešavanja prijave za sledeće otvaranje"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANEL: Data Table & Validations -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- KPI Cards -->
                    <RowDefinition Height="*"/>     <!-- Data Grid -->
                    <RowDefinition Height="Auto"/>  <!-- Napomena o storniranim obračunima -->
                    <RowDefinition Height="Auto"/>  <!-- Validation Alert Box -->
                    <RowDefinition Height="Auto"/>  <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- 1. KPI CARDS (Summary statistics) -->
                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,16">
                    <!-- KPI 1: Zaposleni -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Zaposlenih u prijavi" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalRadnika}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- KPI 2: Bruto -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="8,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Ukupno Bruto (RSD)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding UkupnoBruto, StringFormat=N2}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- KPI 3: Porezi & Doprinosi -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Ukupni doprinosi (teret R+P)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding UkupnoDoprinosi, StringFormat=N2}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 2. DATA GRID PREVIEW -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                    <DataGrid ItemsSource="{Binding Obracuni}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              FrozenColumnCount="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="R.B." Binding="{Binding Radnik.BrojRadnika}" Width="50"/>
                            <DataGridTextColumn Header="Radnik" Binding="{Binding Radnik.ImeIPrezime}" Width="150"/>
                            <DataGridTextColumn Header="JMBG" Binding="{Binding Radnik.Jmbg}" Width="110"/>
                            <DataGridTextColumn Header="SVP" Binding="{Binding Converter={x:Static local:SvpConverter.Instance}}" Width="95"/>
                            <DataGridTextColumn Header="Efekt. sati" Binding="{Binding Converter={x:Static local:EfektivniSatiConverter.Instance}}" Width="85"/>
                            <DataGridTextColumn Header="Fond sati" Binding="{Binding Converter={x:Static local:FondSatiConverter.Instance}}" Width="85"/>
                            <DataGridTextColumn Header="Bruto" Binding="{Binding Converter={x:Static local:BrutoConverter.Instance}, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Osnovica porez" Binding="{Binding PoreskaOsnovica, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="Porez" Binding="{Binding PorezNaDohodak, StringFormat=N2}" Width="85"/>
                            <DataGridTextColumn Header="Osnovica dopr." Binding="{Binding Converter={x:Static local:OsnovicaDoprinosaConverter.Instance}, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="PIO (teret R+P)" Binding="{Binding Converter={x:Static local:PioTotalConverter.Instance}, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="ZDR (teret R+P)" Binding="{Binding Converter={x:Static local:ZdrTotalConverter.Instance}, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="NEZ (teret R+P)" Binding="{Binding Converter={x:Static local:NezTotalConverter.Instance}, StringFormat=N2}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Stornirani obračuni se ne prijavljuju, ali se izostavljanje mora videti -->
                <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="6"
                        Padding="14,10" Margin="0,0,0,12" VerticalAlignment="Top"
                        Visibility="{Binding ImaStorniranih, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap">
                        <Run Text="ℹ️ Storniranih obračuna izostavljeno iz prijave:"/>
                        <Run Text="{Binding BrojStorniranih, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="— ako su već bili u podnetoj prijavi, ovo je sadržaj izmenjene prijave."/>
                    </TextBlock>
                </Border>

                <!-- 3. VALIDATION ALERT BOXES -->
                <Grid Grid.Row="3">
                    <!-- Warning Alerts Panel (Visible when validation failed and validation has been run) -->
                    <Border x:Name="WarningPanel" Background="#FFFBEB" BorderBrush="#FEF3C7" BorderThickness="1.5" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PrikaziUpozorenja}" Value="True"/>
                                            <Condition Binding="{Binding PodaciSuValidni}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="⚠️ Pronađena upozorenja u podacima:" FontWeight="Bold" FontSize="13" Foreground="#B45309" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ValidationAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#92400E" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Success Panel (Visible when validation succeeded and validation has been run) -->
                    <Border x:Name="SuccessPanel" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PrikaziUpozorenja}" Value="True"/>
                                            <Condition Binding="{Binding PodaciSuValidni}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Svi podaci su uspešno validirani i ispunjavaju formalne zahteve Poreske uprave. XML deklaracija je spremna za generisanje!"
                                       FontWeight="Medium" FontSize="13" Foreground="#047857" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. ACTION BUTTONS PANEL -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="🔍  Pokreni validaciju" Style="{StaticResource SecondaryButton}" Command="{Binding ValidateCommand}" Margin="0,0,8,0"/>
                        <Button Content="📋  Kopiraj XML" Style="{StaticResource SecondaryButton}" Click="BtnKopirajXml_Click"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="💾  Generiši PPP-PD XML datoteku" Style="{StaticResource PrimaryButton}" 
                            HorizontalAlignment="Right" Padding="20,10" Click="BtnGenerisiXml_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

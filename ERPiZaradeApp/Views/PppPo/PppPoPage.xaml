<Page x:Class="ERPiZaradeApp.Views.PppPo.PppPoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PPP-PO godišnja potvrda"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Godina" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                <ComboBox x:Name="ComboGodina" Width="100" Height="30" VerticalContentAlignment="Center"
                          SelectionChanged="ComboGodina_SelectionChanged" Margin="0,0,20,0"/>

                <Button Content="🖨️" Style="{StaticResource PrimaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                        Click="BtnJedan_Click" ToolTip="Potvrda za izabranog radnika"/>
                <Button Content="📑" Style="{StaticResource PrimaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                        Click="BtnSvi_Click" ToolTip="Jedan PDF sa potvrdama za sve radnike"/>
                <Button Content="📂" Style="{StaticResource SecondaryButton}" Width="36" Padding="0"
                        Click="BtnPojedinacno_Click" ToolTip="Poseban PDF po radniku u izabrani folder"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="GridObrasci" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Br." Binding="{Binding Radnik.BrojRadnika}" Width="55"/>
                        <DataGridTextColumn Header="Ime i prezime" Binding="{Binding Radnik.ImeIPrezime}" Width="*"/>
                        <DataGridTextColumn Header="JMBG" Binding="{Binding Radnik.Jmbg}" Width="120"/>
                        <DataGridTextColumn Header="Meseci" Binding="{Binding BrojMeseci}" Width="65"/>
                        <DataGridTextColumn Header="Bruto" Binding="{Binding UkupnoBruto, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Porez" Binding="{Binding UkupnoPorez, StringFormat=N2}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Doprinosi" Binding="{Binding UkupnoDoprinosi, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="PanelNalazi" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0"
                    Padding="12" MaxHeight="160" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="KONTROLE" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaNalaza">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" FontSize="12">
                                        <Run Text="["/><Run Text="{Binding TezinaTekst, Mode=OneWay}"/><Run Text="] "/>
                                        <Run Text="{Binding Radnik, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Provera, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=": "/>
                                        <Run Text="{Binding Opis, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

<Page x:Class="ERPiZaradeApp.Views.Praznici.PrazniciPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Kalendar praznika"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── ALATNA TRAKA ───────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Godina" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                <ComboBox x:Name="ComboGodina" Width="100" Height="30" VerticalContentAlignment="Center"
                          SelectionChanged="ComboGodina_SelectionChanged" Margin="0,0,16,0"/>

                <Button Content="📅  Popuni zakonske praznike" Style="{StaticResource SecondaryButton}"
                        Padding="14,6" Margin="0,0,8,0" Click="BtnPopuni_Click"
                        ToolTip="Dodaje zakonske praznike za izabranu godinu; postojeće i ručno unete dane ne dira"/>
                <Button Content="➕" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                        Click="BtnDodaj_Click" ToolTip="Dodaj neradni dan"/>
                <Button Content="🗑" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                        Click="BtnObrisi_Click" ToolTip="Obriši izabrani dan"/>
                <Button Content="💾  Sačuvaj" Style="{StaticResource PrimaryButton}" Padding="16,6"
                        Click="BtnSacuvaj_Click"/>
            </StackPanel>
        </Border>

        <!-- ── SADRŽAJ ────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0">
                <DataGrid x:Name="GridPraznici" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Datum" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding Datum, UpdateSourceTrigger=PropertyChanged}"
                                                BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Neradni" Binding="{Binding Neradni, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Ručno" Binding="{Binding RucniUnos}" Width="70" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MESEČNI FOND SATI" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Radni dani su svi osim subote, nedelje i neradnih dana iz kalendara. Fond je radni dani × 8 sati."/>
                    <DataGrid x:Name="GridFond" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mesec" Binding="{Binding Mesec}" Width="*"/>
                            <DataGridTextColumn Header="Praznici" Binding="{Binding BrojPraznika}" Width="65"/>
                            <DataGridTextColumn Header="Dana" Binding="{Binding RadniDani}" Width="50"/>
                            <DataGridTextColumn Header="Sati" Binding="{Binding FondSati}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── STATUS ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

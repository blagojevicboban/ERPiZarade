<Page x:Class="ERPiZaradeApp.Views.Primanja.PrimanjaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ostala primanja"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPeriod" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Prevoz, jubilarne nagrade, solidarne pomoći i slično. Prekoračenje neoporezivog limita iz šifarnika automatski postaje oporezivo."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="➕" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                            Click="BtnDodaj_Click" ToolTip="Dodaj primanje"/>
                    <Button Content="🗑" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                            Click="BtnObrisi_Click" ToolTip="Obriši izabrano primanje"/>
                    <Button Content="💾  Sačuvaj" Style="{StaticResource PrimaryButton}" Padding="16,6"
                            Click="BtnSacuvaj_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="GridPrimanja" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="KolonaRadnik" Header="Radnik" Width="*"
                                            SelectedValuePath="Id" DisplayMemberPath="Prikaz"
                                            SelectedValueBinding="{Binding RadnikId, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridComboBoxColumn x:Name="KolonaVrsta" Header="Vrsta primanja" Width="240"
                                            SelectedValuePath="VrstaPrimanjaId" DisplayMemberPath="Naziv"
                                            SelectedValueBinding="{Binding VrstaPrimanjaId, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Iznos" Binding="{Binding Iznos, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Napomena" Binding="{Binding Napomena, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

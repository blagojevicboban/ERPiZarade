<Window x:Class="ERPiZaradeApp.Views.Primanja.UvozPutnihNalogaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📥 Uvoz prekoračenja dnevnice iz ERPiFinansije"
        Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Info -->
            <RowDefinition Height="*"/>    <!-- Stavke -->
            <RowDefinition Height="Auto"/> <!-- Nalazi -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Prekoračenje neoporezive dnevnice iz putnih naloga (Faza 3.2)" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Izvezite fajl u ERPiFinansije („Putni nalozi“ → „📤 Izvoz za zarade“), pa ga izaberite ovde. Iznosi ulaze u konačnu zaradu ciljnog meseca kao deo zarade — ne isplaćuju se ponovo, radnik ih je već primio kroz putni nalog."/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnOtvori" Content="📂 Izaberi fajl..." Style="{StaticResource SecondaryButton}" Padding="14,6" Click="BtnOtvori_Click"/>
                    <TextBlock x:Name="TxtFajl" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="JMBG" Binding="{Binding Jmbg}" Width="120"/>
                    <DataGridTextColumn Header="Radnik" Binding="{Binding Prikaz}" Width="*"/>
                    <DataGridTextColumn Header="Nalog" Binding="{Binding BrojNaloga}" Width="110"/>
                    <DataGridTextColumn Header="Iznos" Binding="{Binding Iznos, StringFormat=N2}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="#FFFBEB" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                BorderBrush="#FDE68A" BorderThickness="1" x:Name="PanelNalazi" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Nalazi:" FontWeight="Bold" Margin="0,0,0,4" FontSize="12"/>
                <ItemsControl x:Name="ListaNalaza">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Zatvori" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnZatvori_Click"/>
                <Button x:Name="BtnUvezi" Content="✅ Uvezi" Style="{StaticResource PrimaryButton}" Padding="16,6" IsEnabled="False" Click="BtnUvezi_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

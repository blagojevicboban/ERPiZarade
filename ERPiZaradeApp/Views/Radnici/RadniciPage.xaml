<Page x:Class="ERPiZaradeApp.Views.Radnici.RadniciPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ERPiZaradeApp.Views.Radnici"
      Title="Radnici"
      Background="{StaticResource SurfaceBrush}">

    <Page.DataContext>
        <local:RadniciViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <local:BankCodeToNameConverter x:Key="BankCodeToNameConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>


    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Content: lista + forma -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->

        <!-- ── TOOLBAR ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pretraga -->
                <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,7" FontSize="13"
                                 x:Name="SearchBox"/>
                        <TextBlock Grid.Column="1" Text="Pretraži radnike..." Foreground="#9CA3AF"
                                   FontSize="13" Margin="6,8,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Aktivni checkbox -->
                <CheckBox Grid.Column="1" Content="Samo aktivni"
                          IsChecked="{Binding PrikazujeSamoAktivne}"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>

                <!-- Dugmad -->
                <Button Grid.Column="2" Content="➕  Novi radnik"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewCommand}"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="✏️  Izmeni"
                        Margin="0,0,8,0"
                        Click="BtnIzmeni_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedRadnik, Converter={x:Static local:NullToBoolConverter.Instance}}" Value="True"/>
                                        <Condition Binding="{Binding IsEditing}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="4" Content="🗑️  Deaktiviraj"
                        Command="{Binding DeleteCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedRadnik, Converter={x:Static local:NullToBoolConverter.Instance}}" Value="True"/>
                                        <Condition Binding="{Binding IsEditing}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Lista radnika -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
                <DataGrid x:Name="RadniciGrid"
                          ItemsSource="{Binding Radnici}"
                          SelectedItem="{Binding SelectedRadnik, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Br." Binding="{Binding BrojRadnika}" Width="48"/>
                        <DataGridTextColumn Header="Ime i prezime" Binding="{Binding ImeIPrezime}" Width="*"/>
                        <DataGridTextColumn Header="JMBG" Binding="{Binding Jmbg}" Width="130"/>
                        <DataGridTextColumn Header="Koef." Binding="{Binding Koeficijent, StringFormat=N2}" Width="65"/>
                        <DataGridTextColumn Header="Osnov. plata" Binding="{Binding OsnovnaPlata, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Str. sprema" Binding="{Binding Kategorija}" Width="80"/>
                        <DataGridTextColumn Header="Banka" Binding="{Binding NazivBanke, Converter={StaticResource BankCodeToNameConverter}}" Width="150"/>
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Aktivan}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aktivan"/>
                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aktivan}" Value="False">
                                                            <Setter Property="Text" Value="Neaktivan"/>
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Forma za prikaz/uređivanje -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- Header forme -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Detalji radnika"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="Izmena podataka"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Rectangle Height="2" Margin="0,8,0,0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3949AB" Offset="0"/>
                                        <GradientStop Color="#00BCD4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </StackPanel>

                        <!-- Forma polja -->
                        <StackPanel IsEnabled="{Binding IsEditing}">
                            <!-- Br. radnika + Ime -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Br." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.BrojRadnika, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ime i prezime *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.ImeIPrezime, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- JMBG -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="JMBG" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingRadnik.Jmbg, UpdateSourceTrigger=PropertyChanged}" MaxLength="13"/>
                            </StackPanel>

                            <!-- Mesto i Opština -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Mesto" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox IsEditable="True"
                                              ItemsSource="{Binding DataContext.AvailableMesta, RelativeSource={RelativeSource AncestorType=Page}}"
                                              Text="{Binding EditingRadnik.Mesto, UpdateSourceTrigger=PropertyChanged}"
                                              Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Opština prebivališta" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableOpstine, RelativeSource={RelativeSource AncestorType=Page}}"
                                              SelectedValuePath="Sifra"
                                              DisplayMemberPath="Prikaz"
                                              SelectedValue="{Binding EditingRadnik.SifraOpstine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Height="32" VerticalContentAlignment="Center"
                                              ToolTip="Izaberite opštinu prebivališta iz liste"/>
                                </StackPanel>
                            </Grid>

                            <!-- Datum zaposlenja i prestanka -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Datum zaposlenja" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding EditingRadnik.DatumZaposlenja, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Datum prestanka" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding EditingRadnik.DatumPrestanka, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Koeficijent + Osnov.plata -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Koeficijent" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.Koeficijent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Osnovna plata" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.OsnovnaPlata, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Stručna sprema -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Stručna sprema" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding EditingRadnik.Kategorija, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Sifra"
                                          DisplayMemberPath="Prikaz"
                                          ItemsSource="{Binding DataContext.OpcijeStrucneSpreme, RelativeSource={RelativeSource AncestorType=Page}}"
                                          Padding="8,5" FontSize="13" Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Radno mesto / ŠVP za ePorezi -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Radno mesto" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <CheckBox Grid.Column="1" Content="Standardni ŠVP poreski kod" FontSize="10" IsChecked="{Binding DaLiJeStandardniSvp}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Prikaz standardnih padajućih lista ako je izabran standardni ŠVP kod -->
                                <StackPanel Visibility="{Binding DaLiJeStandardniSvp, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,0">
                                    <!-- Tip primaoca prihoda -->
                                    <TextBlock Text="Tip primaoca (PP)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding OpcijePP}" 
                                              SelectedValuePath="Sifra" 
                                              DisplayMemberPath="Prikaz" 
                                              SelectedValue="{Binding SelectedPP, Mode=TwoWay}"
                                              Margin="0,0,0,8" Height="28" FontSize="12"/>

                                    <!-- Olakšica -->
                                    <TextBlock Text="Poreska olakšica (OL)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding OpcijeOL}"
                                              SelectedValuePath="Sifra"
                                              DisplayMemberPath="Prikaz"
                                              SelectedValue="{Binding SelectedOL, Mode=TwoWay}"
                                              Margin="0,0,0,8" Height="28" FontSize="12"/>

                                    <!-- Dejstvo olakšice: vidljivo tek kad je olakšica izabrana -->
                                    <Grid Margin="0,0,0,8" Visibility="{Binding ImaOlaksicu, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Povraćaj poreza %" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding EditingRadnik.ProcenatPovracajaPoreza, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="28" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="Povraćaj doprinosa %" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding EditingRadnik.ProcenatPovracajaDoprinosa, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="28" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Olakšica važi do" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <DatePicker SelectedDate="{Binding EditingRadnik.OlaksicaVaziDo, UpdateSourceTrigger=PropertyChanged}"
                                                        Height="28" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Beneficirani staž -->
                                    <TextBlock Text="Beneficirani staž (B)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding OpcijeB}" 
                                              SelectedValuePath="Sifra" 
                                              DisplayMemberPath="Prikaz" 
                                              SelectedValue="{Binding SelectedB, Mode=TwoWay}"
                                              Margin="0,0,0,8" Height="28" FontSize="12"/>

                                    <!-- Prikaz generisanog koda -->
                                    <Border Margin="0,4,0,4" Background="#F0F4F8" Padding="8,4" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Generisana poreska šifra: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding EditingRadnik.Radno_Mesto}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Slobodan tekstualni unos ako NIJE standardni ŠVP kod -->
                                <TextBox Text="{Binding EditingRadnik.Radno_Mesto, UpdateSourceTrigger=PropertyChanged}" 
                                         Visibility="{Binding DaLiJeStandardniSvp, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                         Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Bankovni račun -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Bankovni račun" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingRadnik.BankovniRacun, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Banka -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Banka" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableBanke}" 
                                          SelectedValuePath="Sifra" 
                                          DisplayMemberPath="Naziv" 
                                          SelectedValue="{Binding EditingRadnik.NazivBanke, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Padding="8,5" FontSize="13"/>
                            </StackPanel>

                            <!-- E-mail i mesto troška -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="E-mail" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.Email, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Adresa na koju se šalje platni listić"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Mesto troška" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.SifraMestaTroska, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Šifra mesta troška iz ERPiFinansije (npr. MT-01)"/>
                                </StackPanel>
                            </Grid>

                            <!-- Aktivan -->
                            <CheckBox Content="Aktivan zaposleni"
                                      IsChecked="{Binding EditingRadnik.Aktivan}"
                                      FontSize="13" Margin="0,4,0,16"/>

                            <!-- Dugmad -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="💾  Sačuvaj"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveCommand}"
                                        Margin="0,0,0,8"/>
                                <Button Content="✖  Otkaži"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Placeholder kad nema selekcije -->
                        <TextBlock Text="← Izaberite radnika iz liste"
                                   FontSize="13" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditingRadnik}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusPoruka}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

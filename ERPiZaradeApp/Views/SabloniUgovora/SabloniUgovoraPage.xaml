<Page x:Class="ERPiZaradeApp.Views.SabloniUgovora.SabloniUgovoraPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Šabloni ugovora"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Propis određuje obavezne elemente ugovora, ali formulacije bira firma — zato se tekst uređuje ovde, a ne u programu. Polja u vitičastim zagradama zamenjuju se podacima pri generisanju; ono što ostane nepopunjeno vidi se u dokumentu, da se rupa primeti pre potpisa. Izmena šablona ne dira već sačuvane tekstove zaključenih ugovora."/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="➕" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                            Click="BtnDodaj_Click" ToolTip="Dodaj šablon"/>
                    <Button Content="🗑" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                            Click="BtnObrisi_Click" ToolTip="Obriši izabrani šablon"/>
                    <Button Content="💾  Sačuvaj" Style="{StaticResource PrimaryButton}" Padding="16,6"
                            Click="BtnSacuvaj_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <DataGrid x:Name="GridSabloni" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12"
                          SelectionChanged="GridSabloni_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Šifra" Binding="{Binding Sifra, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Aktivan" Binding="{Binding Aktivan, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <TextBox x:Name="TxtTekst" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12.5"
                         Padding="12" BorderThickness="0" Background="Transparent"
                         TextChanged="TxtTekst_TextChanged"/>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="POLJA" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Dvoklik ubacuje polje na mesto kursora."/>

                    <DataGrid x:Name="GridPolja" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11"
                              MouseDoubleClick="GridPolja_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Polje" Binding="{Binding Polje}" Width="135"/>
                            <DataGridTextColumn Header="Značenje" Binding="{Binding Opis}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

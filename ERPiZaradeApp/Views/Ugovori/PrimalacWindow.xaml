<Window x:Class="ERPiZaradeApp.Views.Ugovori.PrimalacWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Primalac po ugovoru" Height="560" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Primalac po ugovoru je karton radnika sa oznakom „Van radnog odnosa“ — odatle se uzimaju JMBG, opština prebivališta i tekući račun, bez kojih nema ni PPP-PD prijave ni naloga za isplatu. Ekrani zarade ga posle toga ne nude za obračun plate, radne sate ni platni listić."/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── NOVI PRIMALAC ──────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="NOVI PRIMALAC" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,10"/>

                    <Button DockPanel.Dock="Bottom" Content="➕  Dodaj primaoca" Style="{StaticResource PrimaryButton}"
                            Height="32" Margin="0,12,0,0" Click="BtnDodaj_Click"/>

                    <StackPanel>
                        <TextBlock Text="Ime i prezime" FontSize="11" Margin="0,0,0,3"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtIme" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                        <TextBlock Text="JMBG" FontSize="11" Margin="0,0,0,3"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtJmbg" Height="30" VerticalContentAlignment="Center" Padding="8,0" MaxLength="13" Margin="0,0,0,10"
                                 ToolTip="Bez JMBG-a primalac ispada iz PPP-PD prijave"/>

                        <TextBlock Text="Adresa" FontSize="11" Margin="0,0,0,3"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtAdresa" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Mesto" FontSize="11" Margin="0,0,0,3"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtMesto" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Šifra opštine" FontSize="11" Margin="0,0,0,3"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtOpstina" Height="30" VerticalContentAlignment="Center" Padding="8,0" MaxLength="3"
                                         ToolTip="Ide u PPP-PD kao oznaka prebivališta"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Tekući račun" FontSize="11" Margin="0,0,0,3"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtRacun" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                        <TextBlock Text="E-mail" FontSize="11" Margin="0,0,0,3"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtEmail" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── POSTOJEĆI KARTON ───────────────────────────────────── -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ILI OZNAČI POSTOJEĆI KARTON" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Kad primalac već postoji u evidenciji (npr. penzioner ili bivši zaposleni), ovde mu se dodaje oznaka. Njegovi zatečeni obračuni ostaju netaknuti."/>

                    <TextBox DockPanel.Dock="Top" x:Name="TxtPretraga" Height="30" VerticalContentAlignment="Center"
                             Padding="8,0" Margin="0,0,0,8" TextChanged="TxtPretraga_TextChanged"
                             ToolTip="Pretraga po imenu, broju radnika ili JMBG-u"/>

                    <Button DockPanel.Dock="Bottom" Content="✔  Označi izabranog" Style="{StaticResource SecondaryButton}"
                            Height="32" Margin="0,10,0,0" Click="BtnOznaci_Click"/>

                    <DataGrid x:Name="GridRadnici" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Br." Binding="{Binding BrojRadnika}" Width="55"/>
                            <DataGridTextColumn Header="Ime i prezime" Binding="{Binding ImeIPrezime}" Width="*"/>
                            <DataGridTextColumn Header="JMBG" Binding="{Binding Jmbg}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>

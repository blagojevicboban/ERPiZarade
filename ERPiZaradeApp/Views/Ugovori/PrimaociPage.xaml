<Page x:Class="ERPiZaradeApp.Views.Ugovori.PrimaociPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Primaoci po ugovoru"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Primaoci su lica kojima je isplaćena naknada po ugovoru van radnog odnosa. Ovo je pogled nad istim registrom kao „Radnici“ — lice u radnom odnosu SME biti i primalac po ugovoru (šifra vrste prihoda tada počinje sa 1 01), i tada se ovde vidi u obe uloge. Godišnja PPP-PO potvrda mu je i dalje jedna."/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="➕" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                            Click="BtnNovi_Click"
                            ToolTip="Novi primalac — otvara unos kartona ili označavanje postojećeg lica"/>
                    <Button Content="🔄" Style="{StaticResource SecondaryButton}" Width="36" Padding="0"
                            Click="BtnOsvezi_Click" ToolTip="Osveži spisak"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="GridPrimaoci" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Br." Binding="{Binding BrojRadnika}" Width="60"/>
                    <DataGridTextColumn Header="Ime i prezime" Binding="{Binding ImeIPrezime}" Width="220"/>
                    <DataGridTextColumn Header="JMBG" Binding="{Binding Jmbg}" Width="130"/>
                    <DataGridTextColumn Header="Tekući račun" Binding="{Binding BankovniRacun}" Width="170"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                    <DataGridTextColumn Header="Ugovora" Binding="{Binding BrojUgovora}" Width="80"/>
                    <DataGridTextColumn Header="Isplata" Binding="{Binding BrojIsplata}" Width="80"/>
                    <DataGridTextColumn Header="Isplaćeno bruto" Binding="{Binding IsplacenoBruto, StringFormat=N2}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock x:Name="StatusMessage" Grid.Row="2" Margin="4,10,0,0" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>

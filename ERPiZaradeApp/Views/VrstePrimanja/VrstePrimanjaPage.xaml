<Page x:Class="ERPiZaradeApp.Views.VrstePrimanja.VrstePrimanjaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Vrste primanja"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Novo primanje se dodaje kao red u ovoj tabeli — bez izmene baze. Sistemske vrste popunjava sam obračun i njima se šifra ne sme menjati. „Na teret Fonda&quot; označava naknadu koju refundira RFZO; ona ulazi u obrazac OZ-10."/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔀" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,16,0"
                            Click="BtnPrevedi_Click"
                            ToolTip="Prevedi zatečene obračune na model stavki (prikazuje probu pre upisa)"/>
                    <Button Content="➕" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                            Click="BtnDodaj_Click" ToolTip="Dodaj vrstu primanja"/>
                    <Button Content="🗑" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,0,8,0"
                            Click="BtnObrisi_Click" ToolTip="Obriši izabranu vrstu"/>
                    <Button Content="💾  Sačuvaj" Style="{StaticResource PrimaryButton}" Padding="16,6"
                            Click="BtnSacuvaj_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="GridVrste" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Šifra" Binding="{Binding Sifra, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="SVP" Binding="{Binding Svp, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridCheckBoxColumn Header="Oporezivo" Binding="{Binding Oporezivo, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <DataGridCheckBoxColumn Header="U osnovici doprinosa" Binding="{Binding UlaziUOsnovicuDoprinosa, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridTextColumn Header="Neoporezivo do" Binding="{Binding NeoporeziviLimit, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Konto" Binding="{Binding Konto, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                    <DataGridCheckBoxColumn Header="Na teret Fonda" Binding="{Binding NaTeretFonda, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Aktivna" Binding="{Binding Aktivna, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Sistemska" Binding="{Binding JeSistemska}" Width="80" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

<Window x:Class="PlataApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PlataApp.Views.Radnici"
        Title="ERPi Zarade — Obračun zarada i kadrovska evidencija"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ══════════════════════════════════════════════ -->
        <Border Grid.Column="0" CornerRadius="0,0,0,0">
            <Border.Resources>
                <!-- Transparent RepeatButton for Track -->
                <Style x:Key="ScrollBarTrackButton" TargetType="RepeatButton">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="false"/>
                    <Setter Property="IsTabStop" Value="false"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Modern ScrollBar Thumb Style for Dark Background -->
                <Style x:Key="SidebarScrollBarThumb" TargetType="Thumb">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="IsTabStop" Value="false"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="rectangle"
                                        CornerRadius="3"
                                        Background="#40FFFFFF"
                                        Margin="2,0,2,0"
                                        Width="6"
                                        HorizontalAlignment="Center"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="rectangle" Property="Background" Value="#80FFFFFF"/>
                                        <Setter TargetName="rectangle" Property="Width" Value="8"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="true">
                                        <Setter TargetName="rectangle" Property="Background" Value="#A0FFFFFF"/>
                                        <Setter TargetName="rectangle" Property="Width" Value="8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Style for ScrollBar within the Sidebar -->
                <Style TargetType="ScrollBar">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="10"/>
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid x:Name="Bg" Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                                                </Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource SidebarScrollBarThumb}"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A237E" Offset="0"/>
                    <GradientStop Color="#283593" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,16,20,10">
                    <TextBlock x:Name="TxtBrandTitle" Text="💼 ERPi Zarade" FontSize="20" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="TxtBrandSubtitle" Text="Obračun zarada i kadrovska evidencija" FontSize="11"
                               Foreground="#90CAF9" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle DockPanel.Dock="Top" Height="1" Margin="16,0"
                           Fill="#20FFFFFF"/>

                <!-- Ime firme -->
                <Border DockPanel.Dock="Top" Margin="12,6,12,3"
                        Background="#20FFFFFF" CornerRadius="8" Padding="12,7"
                        Cursor="Hand" MouseDown="FirmaBorder_MouseDown">
                    <StackPanel>
                        <TextBlock Text="Firma:" FontSize="10" Foreground="#90CAF9"/>
                        <TextBlock x:Name="ImeFirmeText"
                                   Text="Zavod za poljoprivredu"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Aktivni period -->
                <Border x:Name="ActivePeriodBorder" DockPanel.Dock="Top" Margin="12,3,12,3"
                        Background="#15000000" CornerRadius="8" Padding="12,7"
                        Cursor="Hand" MouseDown="ActivePeriodBorder_MouseDown">
                    <StackPanel>
                        <TextBlock Text="Aktivni period:" FontSize="10" Foreground="#90CAF9"/>
                        <TextBlock x:Name="ActivePeriodText"
                                   Text="Nije izabran"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Korisnik info i Odjava -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,8" Background="#15000000" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtImeKorisnika" Text="Prijavljeni korisnik" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="TxtUlogaKorisnika" Grid.Row="1" Text="Uloga" FontSize="10" Foreground="#90CAF9" Margin="0,2,0,0"/>

                        <Button x:Name="BtnOdjava" Grid.Row="3" Content="Odjavi se" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="4,4" Foreground="#90CAF9" BorderBrush="#90CAF9" Click="BtnOdjava_Click" Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- Help dugme na dnu -->
                <Button DockPanel.Dock="Bottom" Content="❓  Korisničko uputstvo"
                        Style="{StaticResource NavButton}" Margin="0,0,0,2"
                        Click="BtnHelp_Click"/>

                <!-- Verzija na dnu -->
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Text="v1.1.0  •  2026"
                           FontSize="11" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,16"/>

                <!-- Navigacija -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="HeaderRadnaTabla" Text="RADNA TABLA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#7986CB" Margin="24,6,0,3"/>
                        <Button x:Name="BtnDashboard" Content="📊  Radna tabla"
                                Style="{StaticResource NavButton}"
                                Click="BtnDashboard_Click"/>

                        <TextBlock x:Name="HeaderObracuni" Text="OBRAČUNI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#7986CB" Margin="24,10,0,3"/>
                        <Button x:Name="BtnObracuni" Content="📁  Obračunski periodi"
                                Style="{StaticResource NavButton}"
                                Click="BtnObracuni_Click"/>

                        <TextBlock x:Name="HeaderEvidencija" Text="EVIDENCIJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#7986CB" Margin="24,10,0,3"/>
                        <Button x:Name="BtnRadnici" Content="👤  Radnici"
                                Style="{StaticResource NavButton}"
                                Click="BtnRadnici_Click"/>
                        <Button x:Name="BtnRadniSati" Content="⏱️  Radni sati"
                                Style="{StaticResource NavButton}"
                                Click="BtnRadniSati_Click"/>
                        <Button x:Name="BtnObracun" Content="📊  Obračun plate"
                                Style="{StaticResource NavButton}"
                                Click="BtnObracun_Click"/>
                        <Button x:Name="BtnPorezi" Content="⚖️  Porezi i parametri"
                                Style="{StaticResource NavButton}"
                                Click="BtnPorezi_Click"/>
                        <Button x:Name="BtnDoprinosi" Content="📈  Doprinosi"
                                Style="{StaticResource NavButton}"
                                Click="BtnDoprinosi_Click"/>
                        <Button x:Name="BtnPlatniRazredi" Content="📊  Platni razredi"
                                Style="{StaticResource NavButton}"
                                Click="BtnPlatniRazredi_Click"/>

                        <TextBlock x:Name="HeaderStampa" Text="ŠTAMPA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#7986CB" Margin="24,10,0,3"/>
                        <Button x:Name="BtnListici" Content="🧾  Platni listići"
                                Style="{StaticResource NavButton}"
                                Click="BtnListici_Click"/>
                        <Button x:Name="BtnStampe" Content="📑  Izveštaji &amp; rekapit."
                                Style="{StaticResource NavButton}"
                                Click="BtnStampe_Click"/>
                        <Button x:Name="BtnPppPd" Content="📋  PPP-PD"
                                Style="{StaticResource NavButton}"
                                Click="BtnPppPd_Click"/>

                        <TextBlock x:Name="HeaderSifarnici" Text="ŠIFARNICI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#7986CB" Margin="24,10,0,3"/>
                        <Button x:Name="BtnKrediti" Content="💳  Krediti"
                                Style="{StaticResource NavButton}"
                                Click="BtnKrediti_Click"/>
                        <Button x:Name="BtnBanke" Content="🏦  Banke"
                                Style="{StaticResource NavButton}"
                                Click="BtnBanke_Click"/>

                        <TextBlock x:Name="HeaderPodesavanja" Text="PODEŠAVANJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#7986CB" Margin="24,10,0,3"/>
                        <Button x:Name="BtnFirme" Content="🏢  Upravljanje firmama"
                                Style="{StaticResource NavButton}"
                                Click="BtnFirme_Click"/>
                        <Button x:Name="BtnKorisnici" Content="👥  Korisnici"
                                Style="{StaticResource NavButton}"
                                Click="BtnKorisnici_Click"/>
                        <Button x:Name="BtnPodesavanja" Content="⚙️  Podešavanja"
                                Style="{StaticResource NavButton}"
                                Click="BtnPodesavanja_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══ SADRŽAJ ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleSidebar" Content="☰" FontSize="16" FontWeight="Bold" Width="36" Height="36"
                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Margin="0,0,16,0" Cursor="Hand"
                            ToolTip="Sklopi / Proširi bočni meni (Ctrl+M)" Click="BtnToggleSidebar_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="TxtHeaderTitle" Text="Radna tabla" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource SurfaceBrush}"/>
        </Grid>
    </Grid>
</Window>

<Page x:Class="PlataApp.Views.Banke.BankePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Šifrarnici banaka"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🏦 Šifrarnici banaka" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Pregled i izmena hronoloških šifarnika banaka i tekućih računa za obračun plata"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.0*"/>  <!-- DataGrid -->
                <ColumnDefinition Width="2.0*"/>  <!-- Edit Panel -->
            </Grid.ColumnDefinitions>


            <!-- LEFT SIDE: DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Search bar -->
                        <RowDefinition Height="*"/>     <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Search and filters -->
                    <Border Grid.Row="0" Background="#F9FAFB" Padding="12" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtPretraga" Height="32" VerticalContentAlignment="Center"
                                     TextChanged="TxtPretraga_TextChanged"/>
                            <TextBlock Grid.Column="1" Text="Pretraži po nazivu ili šifri banke..." Foreground="#9CA3AF"
                                       FontSize="12" Margin="10,8,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtPretraga}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <Button Grid.Column="2" Content="➕  Nova banka" Style="{StaticResource PrimaryButton}"
                                    Width="120" Height="32" Margin="12,0,0,0" Click="BtnNovaBanka_Click"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="GridBanke"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionUnit="FullRow"
                              BorderThickness="0"
                              SelectionChanged="GridBanke_SelectionChanged"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="God." Binding="{Binding Godina}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mes." Binding="{Binding Mesec}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Šifra" Binding="{Binding Sifra}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Naziv banke" Binding="{Binding Naziv}" Width="1.5*"/>
                            <DataGridTextColumn Header="Žiro račun banke" Binding="{Binding ZiroRacun}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT SIDE: Editing Form -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Form Title -->
                        <RowDefinition Height="*"/>     <!-- Form Fields -->
                        <RowDefinition Height="Auto"/>  <!-- Form Actions -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="FormTitle" Text="📝 Uredi podatke o banci" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Šifra banke -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Šifra banke (kolona BANKA u radnicima)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtSifra" Height="32" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F3F4F6"/>
                            </StackPanel>

                            <!-- Naziv banke -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Naziv banke" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtNaziv" Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- Žiro račun -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Žiro tekući račun banke" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtZiroRacun" Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions -->
                    <StackPanel Grid.Row="2">
                        <Button x:Name="BtnSacuvaj" Content="💾  Sačuvaj izmene" Style="{StaticResource PrimaryButton}"
                                Height="40" Margin="0,0,0,10" Click="BtnSacuvaj_Click"/>
                        
                        <Button x:Name="BtnOtkazi" Content="❌  Odustani" Style="{StaticResource SecondaryButton}"
                                Height="36" Margin="0,0,0,10" Click="BtnOtkazi_Click"/>
                        
                        <Button x:Name="BtnObrisi" Content="🗑️  Obriši zapis" Style="{StaticResource SecondaryButton}"
                                Foreground="#E11D48" BorderBrush="#FECDD3" Height="36" Click="BtnObrisi_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

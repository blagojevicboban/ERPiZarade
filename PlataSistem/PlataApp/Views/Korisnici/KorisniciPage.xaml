<Page x:Class="PlataApp.Views.Korisnici.KorisniciPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:korisnici="clr-namespace:PlataApp.Views.Korisnici"
      Title="Korisnici">

    <Page.Resources>
        <korisnici:JeAktivanToTextConverter x:Key="JeAktivanToTextConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Korisnički nalozi" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Upravljanje pristupom i ulogama zaposlenih" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="Novi korisnik" Style="{StaticResource PrimaryButton}"
                    Width="140" Height="36" Click="BtnNoviKorisnik_Click"/>
        </DockPanel>

        <!-- Pretraga -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Pretraga:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtPretraga" Width="200" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretraga_TextChanged"/>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <DataGrid x:Name="DgKorisnici" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime i prezime" Binding="{Binding ImePrezime}" Width="250"/>
                <DataGridTextColumn Header="Korisničko ime" Binding="{Binding KorisnickoIme}" Width="150"/>
                <DataGridTextColumn Header="Uloga" Binding="{Binding Uloga}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding JeAktivan, Converter={StaticResource JeAktivanToTextConverter}}" Width="100"/>

                <DataGridTemplateColumn Header="Akcije" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Izmeni" Style="{StaticResource SecondaryButton}" Tag="{Binding Id}" Click="BtnIzmeni_Click" Margin="0,0,8,0"/>
                                <Button Content="Poništi lozinku" Style="{StaticResource SecondaryButton}" Tag="{Binding Id}" Click="BtnPonistiLozinku_Click" Margin="0,0,8,0"/>
                                <Button Content="Aktiviraj/Deaktiviraj" Style="{StaticResource SecondaryButton}" Tag="{Binding Id}" Click="BtnDeaktiviraj_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

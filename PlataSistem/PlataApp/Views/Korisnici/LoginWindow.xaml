<Window x:Class="PlataApp.Views.Korisnici.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ERPi Zarade — Prijava u sistem" Height="580" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Card -->
            <RowDefinition Height="*"/>    <!-- Form Body -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER CARD (MATCHING HUB) -->
        <Border Grid.Row="0" Margin="16,16,16,0" CornerRadius="12" Padding="20,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4C1D95" Offset="0"/>
                    <GradientStop Color="#5B21B6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💼" FontSize="36" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ERPi Zarade" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Obračun zarada i kadrovska evidencija" FontSize="12" Foreground="#E2E8F0" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORM BODY -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Firma:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6">
                    <TextBlock x:Name="TxtFirma" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Korisničko ime" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUsername" Height="40" FontSize="14" VerticalContentAlignment="Center" Padding="10,0" KeyDown="Input_KeyDown"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Lozinka" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtPassword" Height="40" FontSize="14" VerticalContentAlignment="Center" Padding="10,0" KeyDown="Input_KeyDown"/>
            </StackPanel>

            <Button x:Name="BtnLogin" Content="Prijavi se" Height="44" Style="{StaticResource PrimaryButton}" FontSize="15" FontWeight="SemiBold" Click="BtnLogin_Click"/>

            <TextBlock x:Name="TxtError" Foreground="#DC2626" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- FOOTER -->
        <TextBlock x:Name="TxtVersion" Grid.Row="2" Text="ERPi © 2026 Blagojević Boban" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,16"/>
    </Grid>
</Window>

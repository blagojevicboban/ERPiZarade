<Page x:Class="PlataApp.Views.Krediti.KreditiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PlataApp.Views.Krediti"
      xmlns:radnici="clr-namespace:PlataApp.Views.Radnici"
      Title="Krediti i obustave"
      Background="{StaticResource SurfaceBrush}">

    <Page.DataContext>
        <local:KreditiViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content: lista + krediti -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>


        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEVA STRANA: PRETRAGA I SELEKCIJA ZAPOSLENIH -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Pretraga -->
                        <RowDefinition Height="*"/>     <!-- Lista -->
                    </Grid.RowDefinitions>

                    <!-- Pretraga -->
                    <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,6" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Pretraži radnike..." Foreground="#9CA3AF"
                                       FontSize="12" Margin="6,6,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Lista radnika -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding FilteredRadnici}"
                             SelectedItem="{Binding SelectedRadnik, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#E0E7FF" CornerRadius="4" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BrojRadnika}" FontSize="10" FontWeight="Bold" Foreground="#4338CA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding ImeIPrezime}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Radno_Mesto}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EEF2FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F3F4F6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- DESNA STRANA: DASHBOARD I UPRAVLJANJE KREDITIMA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Kartica sa statistikom -->
                    <RowDefinition Height="*"/>     <!-- Tabela kredita -->
                </Grid.RowDefinitions>

                <!-- STATISTIKA SELEKTOVANOG RADNIKA -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Podaci i Metrike -->
                        <StackPanel Grid.Column="0">
                            <!-- Ime radnika -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedRadnik.ImeIPrezime, FallbackValue='Nijedan radnik nije selektovan'}" 
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Margin="10,0,0,0" Background="#EEF2FF" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding SelectedRadnik.BrojRadnika, StringFormat='Šifra: {0}', FallbackValue='-'}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="#4338CA"/>
                                </Border>
                            </StackPanel>

                            <!-- Mini kartice -->
                            <UniformGrid Columns="2" HorizontalAlignment="Left">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,24,0" Margin="0,0,24,0">
                                    <StackPanel>
                                        <TextBlock Text="PREOSTALI DUG ZA OTPLATU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TotalOutstandingDebt, StringFormat={}{0:N2} RSD, FallbackValue='0.00 RSD'}" 
                                                   FontSize="18" FontWeight="ExtraBold" Foreground="#E11D48" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="0,0,24,0">
                                    <StackPanel>
                                        <TextBlock Text="AKTIVNE OBUSTAVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ActiveCreditsCount, StringFormat='{}{0} kredita', FallbackValue='0 kredita'}" 
                                                   FontSize="18" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Dugmad za akciju -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="170">
                            <Button x:Name="BtnNoviKredit" Content="➕  Novi kredit" 
                                    Style="{StaticResource PrimaryButton}" 
                                    IsEnabled="{Binding SelectedRadnik, Converter={x:Static radnici:NullToBoolConverter.Instance}}"
                                    Click="BtnNoviKredit_Click" Margin="0,0,0,8"/>
                            <Button x:Name="BtnZbirniIzvestaj" Content="🖨️  Zbirni izveštaj" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Click="BtnZbirniIzvestaj_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TABELA KREDITA RADNIKA -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <!-- Grid kad ima kredita -->
                        <DataGrid x:Name="KreditiGrid"
                                  ItemsSource="{Binding Krediti}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionUnit="FullRow"
                                  BorderThickness="0"
                                  Margin="0">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Krediti.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            
                            <DataGrid.Columns>
                                <!-- Opis -->
                                <DataGridTextColumn Header="Opis / Poverilac" Binding="{Binding Opis}" Width="2.0*"/>
                                
                                <!-- Finansije -->
                                <DataGridTextColumn Header="Ukupan dug" Binding="{Binding UkupanIznos, StringFormat=N2}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Mesečna rata" Binding="{Binding MesecnaRata, StringFormat=N2}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Ostatak duga" Binding="{Binding OstatakDuga, StringFormat=N2}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#E11D48"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Progres otplate -->
                                <DataGridTemplateColumn Header="Otplata (Progres)" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="4,0,4,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ProgressBar Value="{Binding PlateneRate}" Maximum="{Binding BrojRata}" 
                                                             Height="6" Foreground="#4338CA" Background="#EEF2FF" BorderThickness="0"/>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Between" Margin="0,3,0,0">
                                                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} / {1} rata">
                                                                <Binding Path="PlateneRate"/>
                                                                <Binding Path="BrojRata"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Aktivnost Checkbox -->
                                <DataGridTemplateColumn Header="Aktivan" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Aktivan, Mode=OneWay}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="CheckBoxAktivan_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Akcije -->
                                <DataGridTemplateColumn Header="Akcije" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" ToolTip="Izmeni dug" Width="26" Height="22" 
                                                        Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,4,0"
                                                        Click="BtnIzmeniKredit_Click"/>
                                                <Button Content="🗑️" ToolTip="Obriši kredit" Width="26" Height="22" 
                                                        Style="{StaticResource SecondaryButton}" Padding="0" Foreground="#E11D48"
                                                        Click="BtnObrisiKredit_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Placeholder kad nema selekcije / kredita -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Krediti.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                                <TextBlock Text="💳" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="Nema evidentiranih kredita za izabranog radnika." FontSize="14" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Kliknite na 'Novi kredit' da biste dodali prvu obustavu." FontSize="12" 
                                           Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

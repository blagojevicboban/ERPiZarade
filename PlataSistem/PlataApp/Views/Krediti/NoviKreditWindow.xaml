<Window x:Class="PlataApp.Views.Krediti.NoviKreditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidencija kredita" 
        Height="440" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Form -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="➕ Unos novog kredita" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="TxtRadnikInfo" Text="Radnik: Goran Popović (Šifra: 4)" FontSize="12" Foreground="#4338CA" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <Rectangle Height="2" Margin="0,8,0,0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3949AB" Offset="0"/>
                        <GradientStop Color="#00BCD4" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </StackPanel>

        <!-- ── FORM ────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- Opis / Poverilac -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Naziv kredita / Poverilac *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtOpis" FontSize="13" Padding="6,6" BorderBrush="{StaticResource BorderBrush}"/>
                </StackPanel>

                <!-- Ukupan iznos i Broj rata -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Ukupan iznos duga (RSD) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUkupanIznos" FontSize="13" Padding="6,6" LostFocus="TxtUkupanIznos_LostFocus"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Broj rata (otplate) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBrojRata" FontSize="13" Padding="6,6" LostFocus="TxtBrojRata_LostFocus"/>
                    </StackPanel>
                </Grid>

                <!-- Mesečna rata i Datum početka -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Mesečna rata (RSD) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMesecnaRata" FontSize="13" Padding="6,6" LostFocus="TxtMesecnaRata_LostFocus"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Prva rata (od meseca) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ComboMesec" Grid.Column="0" Height="30" Margin="0,0,4,0"/>
                            <ComboBox x:Name="ComboGodina" Grid.Column="1" Height="30" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                
                <!-- Status checkbox (samo pri izmeni) -->
                <CheckBox x:Name="CheckAktivno" Content="Obustava je aktivna" FontSize="13" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ── BUTTONS ─────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="✖  Otkaži" Grid.Column="0" Style="{StaticResource SecondaryButton}" Click="BtnOtkazi_Click" Margin="0,0,8,0" Height="35"/>
            <Button Content="💾  Sačuvaj" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="BtnSacuvaj_Click" Margin="8,0,0,0" Height="35"/>
        </Grid>
    </Grid>
</Window>

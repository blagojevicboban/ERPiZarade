<Page x:Class="PlataApp.Views.Listici.ListiciPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PlataApp.Views.Listici"
      Title="Platni listići"
      Background="{StaticResource SurfaceBrush}">

    <Page.DataContext>
        <local:ListiciViewModel/>
    </Page.DataContext>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Filters -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🧾 Masovna štampa platnih listića" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Masovni izvoz u odvojene PDF datoteke ili generisanje jedinstvenog zbirnog dokumenta"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Grid>

        <!-- ── FILTERS ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Godina:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Godine}" SelectedItem="{Binding SelectedGodina}" IsEnabled="False" Margin="0,0,16,0" Padding="8,5"/>

                <TextBlock Grid.Column="2" Text="Mesec:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Meseci}" SelectedItem="{Binding SelectedMesec}" IsEnabled="False" Margin="0,0,16,0" Padding="8,5"/>

                <TextBlock Grid.Column="4" Text="Radnik:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold"/>
                <Border Grid.Column="5" Background="#F9FAFB" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#9CA3AF"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,6" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Pretraži radnike..." Foreground="#9CA3AF"
                                   FontSize="13" Margin="6,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <Button Grid.Column="2" Content="❌" Command="{Binding ClearFilterCommand}"
                                Background="Transparent" BorderThickness="0" Padding="6,0" Cursor="Hand" VerticalAlignment="Center"
                                FontSize="10" Foreground="#9CA3AF">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Lista obračuna -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
                <DataGrid x:Name="ListiciGrid"
                          ItemsSource="{Binding Obracuni}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <!-- Checkbox za selekciju -->
                        <DataGridTemplateColumn Width="45">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding DataContext.AreAllSelected, RelativeSource={RelativeSource AncestorType=Page}}"
                                              Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Br." Binding="{Binding Obracun.Radnik.BrojRadnika}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Zaposleni" Binding="{Binding Obracun.Radnik.ImeIPrezime}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Neto za isplatu (RSD)" Binding="{Binding Obracun.NetoIsplata, StringFormat=N2}" Width="150" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,12,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Bruto (RSD)" Binding="{Binding Obracun.BrutoZarada, StringFormat=N2}" Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Akcija za brzi izvoz jednog radnika -->
                        <DataGridTemplateColumn Header="Akcije" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="📄 PDF" 
                                            Style="{StaticResource SecondaryButton}" 
                                            Padding="6,3" 
                                            FontSize="11"
                                            Click="BtnPojedinacniPdf_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Akcioni panel -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Masovne akcije" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Rectangle Height="2" Margin="0,8,0,16">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3949AB" Offset="0"/>
                                    <GradientStop Color="#00BCD4" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Zbirni PDF -->
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#DCFCE7" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📑 ZBIRNI PDF" FontSize="11" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,6"/>
                                <TextBlock Text="Generiši jedan PDF dokument koji sadrži sve selektovane platne listiće. Svaki zaposleni se automatski pozicionira na novu stranicu." 
                                           FontSize="12" Foreground="#166534" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Preuzmi zbirni PDF" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Background="#16A34A" 
                                        Click="BtnZbirniPdf_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Izvoz odvojenih PDF-ova -->
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#DBEAFE" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📂 BATCH IZVOZ U FOLDER" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                                <TextBlock Text="Izvezi svaki selektovani platni listić kao poseban PDF fajl u izabrani folder. Datoteke se automatski imenuju po zaposlenima." 
                                           FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Izvezi pojedinačne PDF-ove" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Background="#2563EB" 
                                        Click="BtnBatchPdf_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Info rekapitulacija -->
                        <TextBlock Text="Uputstvo i napomene:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="• Označite željene zaposlene u tabeli na levoj strani koristeći kućice za potvrdu (checkbox)." 
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Text="• Gornja kućica u zaglavlju tabele služi za selekciju ili deselekciju svih radnika odjednom." 
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Text="• Platni listići sadrže kompletnu rekapitulaciju radnih sati (redovnih, bolovanja, prekovremenih), bruto iznose, poreze, doprinose na teret zaposlenog i poslodavca, obustave i neto iznos za isplatu." 
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

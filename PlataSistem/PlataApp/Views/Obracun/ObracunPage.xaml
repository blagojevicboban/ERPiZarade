<Page x:Class="PlataApp.Views.Obracun.ObracunPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PlataApp.Views.Obracun"
      Title="Obračun plate"
      Background="{StaticResource SurfaceBrush}">

    <Page.DataContext>
        <local:ObracunViewModel/>
    </Page.DataContext>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Filters -->
            <RowDefinition Height="*"/>     <!-- Main Content (Obračuni list / details) -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="📊 Istorijski obračuni i kalkulacije" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Pregled i pretraga svih istorijskih obračuna plata po mesecima i godinama"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="⚙️ Pokreni novi obračun" 
                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                    Click="BtnNoviObracun_Click"/>
        </Grid>

        <!-- ── FILTERS ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Godina:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Godine}" SelectedItem="{Binding SelectedGodina}" Margin="0,0,16,0" Padding="8,5"/>

                <TextBlock Grid.Column="2" Text="Mesec:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Meseci}" SelectedItem="{Binding SelectedMesec}" Margin="0,0,16,0" Padding="8,5"/>

                <TextBlock Grid.Column="4" Text="Radnik:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold"/>
                <TextBox Grid.Column="5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <Button Grid.Column="7" Content="🔍  Prikaži" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Lista obračuna -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
                <DataGrid x:Name="ObracuniGrid"
                          ItemsSource="{Binding Obracuni}"
                          SelectedItem="{Binding SelectedObracun}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="God." Binding="{Binding Godina}" Width="50"/>
                        <DataGridTextColumn Header="Mes." Binding="{Binding Mesec}" Width="45"/>
                        <DataGridTextColumn Header="Radnik" Binding="{Binding Radnik.ImeIPrezime}" Width="*"/>
                        <DataGridTextColumn Header="Neto za ispl." Binding="{Binding NetoIsplata, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Bruto" Binding="{Binding BrutoZarada, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Porez" Binding="{Binding PorezNaDohodak, StringFormat=N2}" Width="85"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Detaljan prikaz jednog obračuna -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Stavke platnog listića" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Rectangle Height="2" Margin="0,8,0,16">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3949AB" Offset="0"/>
                                    <GradientStop Color="#00BCD4" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel Visibility="{Binding SelectedObracun, Converter={x:Static local:NullToVisibilityConverter.Instance}}">
                            <!-- Lični podaci -->
                            <TextBlock Text="OSNOVNI PODACI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedObracun.Radnik.ImeIPrezime}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedObracun.Radnik.MaticniBroj}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>

                            <!-- Sati i učinak -->
                            <Border Background="#F9FAFB" CornerRadius="6" Padding="12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ODRAĐENI SATI I UČINAK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Redovni radni sati:" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedObracun.RedovniSati}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Bolovanje (sati):" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedObracun.BolovanjeSati}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Prekovremeni rad (sati):" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedObracun.PrekovremeneSati}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Godišnji odmor (sati):" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedObracun.GodisnjioOdmorSati}" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Finansijski iznosi -->
                            <TextBlock Text="FINANSIJSKA REKAPITULACIJA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Bruto zarada:" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedObracun.BrutoZarada, StringFormat=N2}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Bruto bolovanje:" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedObracun.BrutoBolovanje, StringFormat=N2}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Bruto naknade:" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedObracun.BrutoNaknade, StringFormat=N2}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Porez na dohodak:" FontSize="13" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding SelectedObracun.PorezNaDohodak, StringFormat=N2}" HorizontalAlignment="Right" Foreground="#991B1B"/>
                            </Grid>

                            <Separator Margin="0,8"/>

                            <Grid Margin="0,4,0,8">
                                <TextBlock Text="DOPRINOSI (PIO+Zdrav):" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedObracun.DoprinosPioRadnik, StringFormat=N2}" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>

                            <Border Margin="0,4,0,16" Background="#EEF2FF" Padding="8" CornerRadius="6">
                                <Grid>
                                    <TextBlock Text="ZA ISPLATU:" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedObracun.NetoIsplata, StringFormat=N2}" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- PDF i XML izvoz -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📄  Preuzmi PDF" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="BtnStampajListic_Click"/>
                                <Button Grid.Column="1" Content="🌐  Izvezi PPP-PD" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0" Click="BtnIzveziXml_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Placeholder -->
                        <TextBlock Text="← Izaberite obračun za detalje"
                                   FontSize="13" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,40,0,0"
                                   Visibility="{Binding SelectedObracun, Converter={x:Static local:NullToVisibilityConverter.InverseInstance}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

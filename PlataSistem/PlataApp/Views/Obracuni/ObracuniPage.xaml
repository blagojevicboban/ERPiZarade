<Page x:Class="PlataApp.Views.Obracuni.ObracuniPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Istorijski obračuni"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <!-- Cell alignment styles -->
        <Style x:Key="LeftAlignedCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Table Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🏢 Pregled svih obračuna" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="FirmaSubtitle" Text="Pregled svih obračunatih perioda i finansijskih rekapitulacija za firmu"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- ── CONTENT ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,16,20,12">
                    <TextBlock Text="📊 Istorijski obračunati periodi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Dvaput kliknite na period ili kliknite na dugme 'Otvori' sa desne strane da učitate detaljan obračun" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <DataGrid x:Name="PeriodiGrid" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single"
                          MouseDoubleClick="PeriodiGrid_MouseDoubleClick"
                          BorderThickness="0"
                          Background="Transparent"
                          HeadersVisibility="Column"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Period obračuna" Binding="{Binding PeriodStr}" Width="150" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Broj zaposlenih" Binding="{Binding BrojRadnika}" Width="150" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTextColumn Header="Ukupno Bruto" Binding="{Binding UkupnoBruto, StringFormat=N2}" Width="*" ElementStyle="{StaticResource RightAlignedCell}"/>
                        <DataGridTextColumn Header="Ukupno za isplatu (Neto)" Binding="{Binding UkupnoNeto, StringFormat=N2}" Width="*" ElementStyle="{StaticResource RightAlignedCell}"/>
                        <DataGridTextColumn Header="Datum obračuna" Binding="{Binding PoslednjiDatum, StringFormat={}{0:dd.MM.yyyy}}" Width="180" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        
                        <!-- Akciona kolona -->
                        <DataGridTemplateColumn Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁️ Otvori" 
                                            Style="{StaticResource SecondaryButton}" 
                                            Padding="10,4" 
                                            Height="24"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Click="BtnOtvori_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Učitavanje..." FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

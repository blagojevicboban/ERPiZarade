<Page x:Class="PlataApp.Views.Obracuni.ObracuniPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Istorijski obračuni"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Cell alignment styles -->
        <Style x:Key="LeftAlignedCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Destructive action button style (e.g. Delete) -->
        <Style x:Key="DestructiveButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderBrush="#EF4444" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#991B1B"/>
                                <Setter Property="BorderBrush" Value="#991B1B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Table Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🏢 Pregled svih obračuna" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="FirmaSubtitle" Text="Pregled svih obračunatih perioda i finansijskih rekapitulacija za firmu"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnZakljucajSve" Content="🔒 Zaključaj sve otključane periode" 
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Click="BtnZakljucajSve_Click"
                        ToolTip="Zaključava sve dosadašnje otključane obračunske periode odjednom"/>
                <Button Content="⚙️ Pokreni novi obračun" 
                        Style="{StaticResource PrimaryButton}" 
                        Click="BtnNoviObracun_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── CONTENT ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,16,20,12">
                    <TextBlock Text="📊 Istorijski obračunati periodi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Dvaput kliknite na period ili kliknite na dugme 'Otvori' sa desne strane da učitate detaljan obračun" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <DataGrid x:Name="PeriodiGrid" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single"
                          MouseDoubleClick="PeriodiGrid_MouseDoubleClick"
                          BorderThickness="0"
                          Background="Transparent"
                          HeadersVisibility="Column"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                              Checked="CheckBox_SelectionChanged" Unchecked="CheckBox_SelectionChanged"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Period obračuna" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PeriodStr}" VerticalAlignment="Center" FontSize="13"/>
                                        <Border Margin="8,0,0,0" Background="#D1FAE5" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="AKTIVAN" FontSize="9" FontWeight="Bold" Foreground="#065F46"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Broj zaposlenih" Binding="{Binding BrojRadnika}" Width="130" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBorder" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#10B981">
                                        <TextBlock x:Name="StatusText" Text="🔓 Otvoreno" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Zakljucan}" Value="True">
                                            <Setter TargetName="StatusBorder" Property="Background" Value="#EF4444"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="🔒 Zaključano"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Vrednost boda" Binding="{Binding VrednostBoda, StringFormat=N4}" Width="130" ElementStyle="{StaticResource RightAlignedCell}"/>
                        <DataGridTextColumn Header="Ukupno Bruto" Binding="{Binding UkupnoBruto, StringFormat=N2}" Width="*" ElementStyle="{StaticResource RightAlignedCell}"/>
                        <DataGridTextColumn Header="Ukupno Bruto 2" Binding="{Binding UkupnoBruto2, StringFormat=N2}" Width="*" ElementStyle="{StaticResource RightAlignedCell}"/>
                        <DataGridTextColumn Header="Ukupno za isplatu (Neto)" Binding="{Binding UkupnoNeto, StringFormat=N2}" Width="*" ElementStyle="{StaticResource RightAlignedCell}"/>
                        <DataGridTextColumn Header="Datum obračuna" Binding="{Binding PoslednjiDatum, StringFormat={}{0:dd.MM.yyyy}}" Width="180" ElementStyle="{StaticResource CenterAlignedCell}"/>
                        
                        <!-- Akciona kolona -->
                        <DataGridTemplateColumn Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="👁️ Otvori" 
                                                Style="{StaticResource SecondaryButton}" 
                                                Padding="10,2" 
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Click="BtnOtvori_Click"/>
                                        <Button x:Name="BtnLock"
                                                Content="🔒 Zaključaj" 
                                                Style="{StaticResource SecondaryButton}" 
                                                Padding="10,2" 
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Click="BtnZakljucaj_Click"/>
                                        <Button x:Name="BtnDelete"
                                                Content="🗑️ Obriši" 
                                                Style="{StaticResource DestructiveButton}" 
                                                Padding="10,2" 
                                                VerticalAlignment="Center"
                                                Click="BtnObrisi_Click"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Zakljucan}" Value="True">
                                            <Setter TargetName="BtnLock" Property="Content" Value="🔓 Otključaj"/>
                                            <!-- Onemoguci brisanje ako je zakljucano -->
                                            <Setter TargetName="BtnDelete" Property="IsEnabled" Value="False"/>
                                            <Setter TargetName="BtnDelete" Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#F0FDF4"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="StatusMessage" Text="Učitavanje..." FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button x:Name="BtnRetroaktivniDoprinosi"
                        Content="🔄  Preračunaj doprinose poslodavca (retroaktivno)"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,4"
                        Click="BtnRetroaktivniDoprinosi_Click"
                        IsEnabled="False"
                        ToolTip="Preračunava doprinose na teret poslodavca za sve istorijske obračune gde su vrednosti 0"/>
            </Grid>
        </Border>
    </Grid>
</Page>

<Page x:Class="PlataApp.Views.PlatniRazredi.PlatniRazrediPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Platni razredi"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- ScrollViewer Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->

        <!-- ── CONTENT ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📊 Platni razredi - Najniže bruto osnovice" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Pregled i izmena najnižih bruto osnovica za stepene stručne spreme (Normalni doprinosi i Doprinosi za PIO)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Grid sa naslovima kolona -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stepen stručne spreme" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Normalni doprinosi" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Doprinos za PIO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                    
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                    <!-- Grid sa stepenima i inputima -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- I i II stepen -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Osnovica za I i II stepen (1)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR1" Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP1" Grid.Row="0" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>

                        <!-- III stepen -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Osnovica za III stepen (2)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR2" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP2" Grid.Row="1" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>

                        <!-- IV stepen -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Osnovica za IV stepen (3)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR3" Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP3" Grid.Row="2" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>

                        <!-- V stepen -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Osnovica za V stepen (4)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR4" Grid.Row="3" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP4" Grid.Row="3" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>

                        <!-- VI stepen -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Osnovica za VI stepen (5)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR5" Grid.Row="4" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP5" Grid.Row="4" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>

                        <!-- VII1 stepen -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Osnovica za VII1 stepen (6)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR6" Grid.Row="5" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP6" Grid.Row="5" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>

                        <!-- VII2 stepen -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Osnovica za VII2 stepen (7)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR7" Grid.Row="6" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP7" Grid.Row="6" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>

                        <!-- VIII stepen -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Osnovica za VIII stepen (8)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR8" Grid.Row="7" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP8" Grid.Row="7" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>

                        <!-- Rezerva -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Rezerva (9)" VerticalAlignment="Center" Margin="0,0,0,10" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="TxtR9" Grid.Row="8" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                        <TextBox x:Name="TxtP9" Grid.Row="8" Grid.Column="2" Height="32" VerticalContentAlignment="Center" Margin="10,0,10,10" TextAlignment="Right"/>
                    </Grid>

                    <Button x:Name="BtnSacuvajRazredi" Content="💾 Sačuvaj platne razrede" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,16,0,0" Click="BtnSacuvajRazredi_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

<Page x:Class="PlataApp.Views.Podesavanja.PodesavanjaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Podešavanja"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <!-- Modern TabControl / TabItem styles -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Tab Control Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ Podešavanja" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Upravljanje osnovnim podacima o firmi i kreiranje/vraćanje rezervne kopije baze podataka"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- ── TAB CONTROL CONTENT ─────────────────────────────────── -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: Podaci o firmi -->
            <TabItem Header="🏢 Podaci o firmi">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🏢 Podaci o firmi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Pregled i izmena osnovnih identifikacionih podataka isplatioca zarada uvezenih iz korisnic.dbf" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Naziv firme -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,12">
                                    <TextBlock Text="Naziv firme:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaNaziv" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Adresa -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,12">
                                    <TextBlock Text="Adresa:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaAdresa" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Grad -->
                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,12,12">
                                    <TextBlock Text="Grad:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaGrad" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- PIB -->
                                <StackPanel Grid.Column="1" Grid.Row="1" Margin="12,0,0,12">
                                    <TextBlock Text="Poreski identifikacioni broj (PIB):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaPib" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Matični Broj (MB) -->
                                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,12,12">
                                    <TextBlock Text="Matični broj (MB):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaMb" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Bankovni račun -->
                                <StackPanel Grid.Column="1" Grid.Row="2" Margin="12,0,0,12">
                                    <TextBlock Text="Bankovni tekući račun:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaBankovniRacun" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Šifra plaćanja -->
                                <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,12,12">
                                    <TextBlock Text="Šifra plaćanja (podrazumevana):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaSifraPlacanja" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Telefon -->
                                <StackPanel Grid.Column="1" Grid.Row="3" Margin="12,0,0,12">
                                    <TextBlock Text="Telefon:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaTelefon" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Email -->
                                <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,12,12">
                                    <TextBlock Text="Email adresa:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaEmail" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Napomena -->
                                <StackPanel Grid.Column="1" Grid.Row="4" Margin="12,0,0,12">
                                    <TextBlock Text="Napomena:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFirmaNapomena" Height="32" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnSacuvajFirma" Content="💾 Sačuvaj podatke o firmi" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,16,0,0" Click="BtnSacuvajFirma_Click"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Rezervna kopija -->
            <TabItem Header="💾 Rezervna kopija">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEVO: Kreiranje rezervne kopije -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,16">
                            <StackPanel>
                                <TextBlock Text="💾 Kreiranje rezervne kopije (Backup)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Sačuvajte trenutno stanje baze podataka na sigurnu lokaciju." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                <TextBlock Text="Trenutna lokacija aktivne baze podataka:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtAktivnaBazaPath" IsReadOnly="True" Background="#F3F4F6" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                                <TextBlock Text="Preporučeno ime za rezervnu kopiju:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPredlozenoIme" IsReadOnly="True" Background="#F3F4F6" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,24"/>

                                <Button x:Name="BtnKreirajBackup" Content="💾 Napravi rezervnu kopiju baze podataka" Style="{StaticResource PrimaryButton}" Height="40" Click="BtnKreirajBackup_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- DESNO: Vraćanje iz rezervne kopije -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🔄 Vraćanje podataka iz rezervne kopije (Restore)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Učitajte prethodno sačuvane podatke. Pažnja: trenutni podaci će biti prepisani!" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                <Border Background="#FFF3CD" CornerRadius="8" Padding="12" Margin="0,0,0,20" BorderBrush="#FFEBA0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ VAŽNO UPOZORENJE" FontWeight="Bold" Foreground="#856404" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBlock Text="Vraćanje podataka iz rezervne kopije će u potpunosti zameniti sve trenutne podatke u sistemu (radnike, obračune, poreske stope i podešavanja). Pre nego što nastavite, preporučuje se da napravite rezervnu kopiju trenutne baze." TextWrapping="Wrap" Foreground="#856404" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="BtnVratiBackup" Content="📁 Izaberi i vrati bazu podataka iz kopije" Style="{StaticResource SecondaryButton}" BorderBrush="#DC3545" Foreground="#DC3545" Height="40" Click="BtnVratiBackup_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

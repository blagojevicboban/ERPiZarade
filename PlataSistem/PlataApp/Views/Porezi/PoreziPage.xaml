<Page x:Class="PlataApp.Views.Porezi.PoreziPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Porezi i opšti parametri"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <!-- Cell alignment styles -->
        <Style x:Key="LeftAlignedCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar (Izbor perioda) -->
            <RowDefinition Height="*"/>     <!-- ScrollViewer Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚖️ Porezi i opšti parametri" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Upravljanje poreskim stopama, mesečnim limitima, opštim parametrima i procentima uvećanja"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- ── TOOLBAR (Izbor perioda) ──────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Godina:" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox x:Name="ComboGodina" Grid.Column="1" VerticalAlignment="Center" Height="32" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="2" Text="Mesec:" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox x:Name="ComboMesec" Grid.Column="3" VerticalAlignment="Center" Height="32" Margin="0,0,16,0"/>

                <Button Grid.Column="4" Content="🔄  Učitaj parametre"
                        Style="{StaticResource SecondaryButton}" Padding="16,6"
                        Click="BtnUcitaj_Click"/>

                <Button Grid.Column="6" Content="💾  Sačuvaj podešavanja poreza"
                        Style="{StaticResource PrimaryButton}" Padding="20,7"
                        Click="BtnSacuvaj_Click"/>
            </Grid>
        </Border>

        <!-- ── CONTENT ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── KARTICA 1: OPŠTI PARAMETRI (Levo) ────────────────── -->
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="💼 Opšti obračunski parametri" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                        <!-- Garantovana zarada -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Garantovana zarada (minimalna neto):" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtZarada" Grid.Column="1" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Vrednost boda -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Trenutna vrednost boda:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtVrBoda" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>

                        <!-- Fond časova -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mesečni fond časova:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtFondCasova" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>

                        <!-- Časova za obračun -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Planirano časova za obračun:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtCasZaOb" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>

                        <!-- Akontacija -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Plaćanje akontacije (DA/NE):" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <ComboBox x:Name="ComboAkont" Grid.Column="1" Height="32">
                                <ComboBoxItem Content="DA"/>
                                <ComboBoxItem Content="NE"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── KARTICA 2: PORESKE STOPE (Desno) ──────────────────── -->
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⚖️ Poreske stope i limiti" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                        <!-- Prva stopa poreza -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1. stopa poreza (%):" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtAkPorez" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>

                        <!-- Poresko oslobodjenje (Prvast) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mesečni iznos poreskog oslobođenja:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtPrvast" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>

                        <!-- Gornja granica 2. stope (Drugast) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gornja granica 2. stope poreza:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtDrugast" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>

                        <!-- AkPorez2 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dodatni porez stopa 2 (iznad limit 1):" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtAkPorez2" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>

                        <!-- AkPorez3 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dodatni porez stopa 3 (iznad limit 2):" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtAkPorez3" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── KARTICA 3: OSNOVNI POREZ (Levo) ──────────────────── -->
                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="🏢 Platni detalji: OSNOVNI POREZ" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                        <!-- Šifra plaćanja -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Šifra plaćanja:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtSifPlac1" Grid.Column="1"/>
                        </Grid>

                        <!-- Žiro račun -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Žiro račun:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtZiroR1" Grid.Column="1"/>
                        </Grid>

                        <!-- Pozivi na broj -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Poziv na broj:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtPozivNa1" Grid.Column="1" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtPozivNa3" Grid.Column="3"/>
                        </Grid>

                        <!-- Svrha -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Svrha plaćanja:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtSvrha1" Grid.Column="1"/>
                        </Grid>

                        <!-- Primalac -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Primalac:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtPrimalac1" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── KARTICA 4: DODATNI POREZ (Desno) ─────────────────── -->
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🏢 Platni detalji: DODATNI POREZ" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                        <!-- Šifra plaćanja -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Šifra plaćanja:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtSifPlac2" Grid.Column="1"/>
                        </Grid>

                        <!-- Žiro račun -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Žiro račun:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtZiroR2" Grid.Column="1"/>
                        </Grid>

                        <!-- Pozivi na broj -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Poziv na broj:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtPozivNa2" Grid.Column="1" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtPozivNa4" Grid.Column="3"/>
                        </Grid>

                        <!-- Svrha -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Svrha plaćanja:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtSvrha3" Grid.Column="1"/>
                        </Grid>

                        <!-- Primalac -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Primalac:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox x:Name="TxtPrimalac3" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── KARTICA 5: PROCENTI UVEĆANJA (Spojeno dole) ───────── -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📈 Procenti uvećanja zarada i naknada" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                        <!-- Grid sa procentima -->
                        <UniformGrid Columns="3" Rows="3">
                            <!-- Državni praznik -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% uvećanja za rad praznikom:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcDrzav" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Noćni rad -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% uvećanja za noćni rad:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcNocni" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Prekovremeni rad -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% uvećanja za prekovremeni rad:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcPreko" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Minuli rad godišnje -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% minuli rad (godišnje):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcMinul" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Rad nedeljom -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% naknade za rad nedeljom:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcNedel" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Bolovanje -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% naknade za bolovanje:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcBolov" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Plaćeno odsustvo -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% naknade za plaćeno odsustvo:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcPlac" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Zakonsko plaćeno odsustvo -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% zakonskog plaćenog odsustva:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcPlZa" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Invalidi II kategorije -->
                            <StackPanel Margin="10,0,10,12">
                                <TextBlock Text="% naknade za invalide II kat.:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProcInval" TextAlignment="Right"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusMessage" Text="Spreman" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

<Page x:Class="PlataApp.Views.PppPd.PppPdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PlataApp.Views.PppPd"
      Title="PPP-PD poreska deklaracija"
      Background="{StaticResource SurfaceBrush}">

    <Page.DataContext>
        <local:PppPdViewModel/>
    </Page.DataContext>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="📋 Poreska uprava — PPP-PD prijava" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Pregled, pre-validacija poreskih osnovica i generisanje XML datoteke poreske deklaracije za Poresku Upravu Republike Srbije"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Grid>

        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>  <!-- Left Panel: Parameters -->
                <ColumnDefinition Width="*"/>    <!-- Right Panel: Data table & validation -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Parameters Form -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Section: Selection and Parameters -->
                        <TextBlock Text="PARAMETRI PRIJAVE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Godina:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding Godine}" SelectedItem="{Binding SelectedGodina}" IsEnabled="False" Padding="8,5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Mesec:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding Meseci}" SelectedItem="{Binding SelectedMesec}" IsEnabled="False" Padding="8,5"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Datum plaćanja:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DatePicker SelectedDate="{Binding DatumPlacanja, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Klijentska oznaka:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding KlijentskaOznaka, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Vrsta prijave:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox SelectedValue="{Binding SelectedVrstaPrijave}" SelectedValuePath="Tag" Margin="0,0,0,10" Padding="8,5">
                            <ComboBoxItem Content="1 - Opšta prijava" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="2 - Po nalazu kontrole" Tag="2"/>
                            <ComboBoxItem Content="3 - Po odluci suda" Tag="3"/>
                            <ComboBoxItem Content="4 - Po samoprijavljivanju" Tag="4"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Oznaka konačne:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox SelectedValue="{Binding SelectedOznakaZaKonacnu}" SelectedValuePath="Tag" Padding="8,5">
                                    <ComboBoxItem Content="K - Konačna" Tag="K" IsSelected="True"/>
                                    <ComboBoxItem Content="A - Akontacija" Tag="A"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Najniža osnovica:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox SelectedValue="{Binding SelectedNajnizaOsnovica}" SelectedValuePath="Tag" Padding="8,5">
                                    <ComboBoxItem Content="0 - Bez primene" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="1 - Sa primenom" Tag="1"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Tip isplatioca:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox SelectedValue="{Binding SelectedTipIsplatioca}" SelectedValuePath="Tag" Margin="0,0,0,16" Padding="8,5">
                            <ComboBoxItem Content="1 - Pravno lice" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="2 - Preduzetnik" Tag="2"/>
                            <ComboBoxItem Content="3 - Fizičko lice" Tag="3"/>
                        </ComboBox>

                        <Separator Margin="0,4,0,12"/>

                        <!-- Section: Employer Info -->
                        <TextBlock Text="PODACI O ISPLATIOCU" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Naziv isplatioca:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Naziv, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="PIB:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding Pib, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Matični broj:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding MaticniBroj, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Sedište (Opština):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding Sediste, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Telefon:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Adresa isplatioca:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Adresa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="E-mail:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANEL: Data Table & Validations -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- KPI Cards -->
                    <RowDefinition Height="*"/>     <!-- Data Grid -->
                    <RowDefinition Height="Auto"/>  <!-- Validation Alert Box -->
                    <RowDefinition Height="Auto"/>  <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- 1. KPI CARDS (Summary statistics) -->
                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,16">
                    <!-- KPI 1: Zaposleni -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Zaposlenih u prijavi" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalRadnika}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- KPI 2: Bruto -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="8,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Ukupno Bruto (RSD)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding UkupnoBruto, StringFormat=N2}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- KPI 3: Porezi & Doprinosi -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Ukupni doprinosi (teret R+P)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding UkupnoDoprinosi, StringFormat=N2}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 2. DATA GRID PREVIEW -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                    <DataGrid ItemsSource="{Binding Obracuni}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="R.B." Binding="{Binding Radnik.BrojRadnika}" Width="50"/>
                            <DataGridTextColumn Header="Radnik" Binding="{Binding Radnik.ImeIPrezime}" Width="*"/>
                            <DataGridTextColumn Header="JMBG" Binding="{Binding Radnik.Jmbg}" Width="110"/>
                            <DataGridTextColumn Header="Bruto" Binding="{Binding Converter={x:Static local:BrutoConverter.Instance}, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Osnovica porez" Binding="{Binding PoreskaOsnovica, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="Porez" Binding="{Binding PorezNaDohodak, StringFormat=N2}" Width="85"/>
                            <DataGridTextColumn Header="PIO (teret R+P)" Binding="{Binding Converter={x:Static local:PioTotalConverter.Instance}, StringFormat=N2}" Width="105"/>
                            <DataGridTextColumn Header="ZDR (teret R+P)" Binding="{Binding Converter={x:Static local:ZdrTotalConverter.Instance}, StringFormat=N2}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 3. VALIDATION ALERT BOXES -->
                <Grid Grid.Row="2">
                    <!-- Warning Alerts Panel (Visible when validation failed and validation has been run) -->
                    <Border x:Name="WarningPanel" Background="#FFFBEB" BorderBrush="#FEF3C7" BorderThickness="1.5" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PrikaziUpozorenja}" Value="True"/>
                                            <Condition Binding="{Binding PodaciSuValidni}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="⚠️ Pronađena upozorenja u podacima:" FontWeight="Bold" FontSize="13" Foreground="#B45309" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ValidationAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#92400E" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Success Panel (Visible when validation succeeded and validation has been run) -->
                    <Border x:Name="SuccessPanel" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PrikaziUpozorenja}" Value="True"/>
                                            <Condition Binding="{Binding PodaciSuValidni}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Svi podaci su uspešno validirani i ispunjavaju formalne zahteve Poreske uprave. XML deklaracija je spremna za generisanje!"
                                       FontWeight="Medium" FontSize="13" Foreground="#047857" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. ACTION BUTTONS PANEL -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="🔍  Pokreni validaciju" Style="{StaticResource SecondaryButton}" Command="{Binding ValidateCommand}" Margin="0,0,8,0"/>
                        <Button Content="📋  Kopiraj XML" Style="{StaticResource SecondaryButton}" Click="BtnKopirajXml_Click"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="💾  Generiši PPP-PD XML datoteku" Style="{StaticResource PrimaryButton}" 
                            HorizontalAlignment="Right" Padding="20,10" Click="BtnGenerisiXml_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>

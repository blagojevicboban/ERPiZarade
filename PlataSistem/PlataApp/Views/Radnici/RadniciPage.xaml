<Page x:Class="PlataApp.Views.Radnici.RadniciPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PlataApp.Views.Radnici"
      Title="Radnici"
      Background="{StaticResource SurfaceBrush}">

    <Page.DataContext>
        <local:RadniciViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <local:BankCodeToNameConverter x:Key="BankCodeToNameConverter"/>
    </Page.Resources>


    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Content: lista + forma -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="👤 Radnici" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Evidencija zaposlenih i njihovih podataka"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- ── TOOLBAR ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pretraga -->
                <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4,7" FontSize="13"
                                 x:Name="SearchBox"/>
                        <TextBlock Grid.Column="1" Text="Pretraži radnike..." Foreground="#9CA3AF"
                                   FontSize="13" Margin="6,8,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Aktivni checkbox -->
                <CheckBox Grid.Column="1" Content="Samo aktivni"
                          IsChecked="{Binding PrikazujeSamoAktivne}"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>

                <!-- Dugmad -->
                <Button Grid.Column="2" Content="➕  Novi radnik"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewCommand}"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="✏️  Izmeni"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding SelectedRadnik, Converter={x:Static local:NullToBoolConverter.Instance}}"
                        Click="BtnIzmeni_Click"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="🗑️  Deaktiviraj"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DeleteCommand}"/>
            </Grid>
        </Border>

        <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Lista radnika -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
                <DataGrid x:Name="RadniciGrid"
                          ItemsSource="{Binding Radnici}"
                          SelectedItem="{Binding SelectedRadnik, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Br." Binding="{Binding BrojRadnika}" Width="48"/>
                        <DataGridTextColumn Header="Ime i prezime" Binding="{Binding ImeIPrezime}" Width="*"/>
                        <DataGridTextColumn Header="JMBG / Mat.br." Binding="{Binding MaticniBroj}" Width="130"/>
                        <DataGridTextColumn Header="Koef." Binding="{Binding Koeficijent, StringFormat=N2}" Width="65"/>
                        <DataGridTextColumn Header="Osnov. plata" Binding="{Binding OsnovnaPlata, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Banka" Binding="{Binding NazivBanke, Converter={StaticResource BankCodeToNameConverter}}" Width="150"/>
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Aktivan}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aktivan"/>
                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aktivan}" Value="False">
                                                            <Setter Property="Text" Value="Neaktivan"/>
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Forma za prikaz/uređivanje -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- Header forme -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Detalji radnika"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="Izmena podataka"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Rectangle Height="2" Margin="0,8,0,0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3949AB" Offset="0"/>
                                        <GradientStop Color="#00BCD4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </StackPanel>

                        <!-- Forma polja -->
                        <StackPanel IsEnabled="{Binding IsEditing}">
                            <!-- Br. radnika + Ime -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Br." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.BrojRadnika, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ime i prezime *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.ImeIPrezime, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- JMBG -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="JMBG" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingRadnik.Jmbg, UpdateSourceTrigger=PropertyChanged}" MaxLength="13"/>
                            </StackPanel>

                            <!-- Matični broj -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Matični broj" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingRadnik.MaticniBroj, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Koeficijent + Osnov.plata -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Koeficijent" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.Koeficijent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Osnovna plata" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingRadnik.OsnovnaPlata, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Radno mesto -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Radno mesto" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingRadnik.Radno_Mesto, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Bankovni račun -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Bankovni račun" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingRadnik.BankovniRacun, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Banka -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Banka (šifra)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding EditingRadnik.NazivBanke, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Border Grid.Column="1" Margin="12,0,0,0" Background="#EEF2FF" CornerRadius="6" Padding="10,0" VerticalAlignment="Stretch">
                                        <TextBlock Text="{Binding EditingRadnik.NazivBanke, Converter={StaticResource BankCodeToNameConverter}}" 
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#4338CA" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Aktivan -->
                            <CheckBox Content="Aktivan zaposleni"
                                      IsChecked="{Binding EditingRadnik.Aktivan}"
                                      FontSize="13" Margin="0,4,0,16"/>

                            <!-- Dugmad -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="💾  Sačuvaj"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveCommand}"
                                        Margin="0,0,0,8"/>
                                <Button Content="✖  Otkaži"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Placeholder kad nema selekcije -->
                        <TextBlock Text="← Izaberite radnika iz liste"
                                   FontSize="13" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditingRadnik}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── STATUS BAR ────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,12,0,0"
                Background="White" CornerRadius="6" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock Text="{Binding StatusPoruka}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>
